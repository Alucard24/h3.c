/* Vulkan compute kernels for the h3 GPU backend.
 *
 * This file mirrors the portable kernels in h3_shaders.metal with identical
 * arithmetic semantics. BF16 conversion uses the exact round-to-nearest-even
 * sequence from the Metal source. Kernel-by-kernel, this file will grow to
 * cover the full h3_gpu API.
 *
 * All kernels share one descriptor layout: set 0, storage-buffer bindings
 * 0..7, and a single push-constant block whose layout must match
 * h3_gpu_vulkan_push in h3_gpu_vulkan.c.
 */
#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require

#define H3_BF16_TO_F32(value) uintBitsToFloat(uint(value) << 16)

uint h3_f32_to_bf16(float value) {
    uint bits = floatBitsToUint(value);
    bits += 0x7fffu + ((bits >> 16) & 1u);
    return bits >> 16;
}

/* glslang rejects push-constant blocks in modules that also declare 16-bit
 * storage buffers, so kernel arguments travel through a small uniform args
 * buffer (binding 7). The layout must match h3_gpu_vulkan_args in
 * h3_gpu_vulkan.c. */
struct H3Args {
    uint count;
    uint elements;
    uint sample_offset;
    uint tokens;
    uint width;
    uint rows;
    uint vocab_size;
    uint approximate;
    float left_scale;
    float right_scale;
    float minimum;
    float maximum;
    float delta;
    float ratio;
    float epsilon;
    uint has_bias;
    uint input_dim;
    uint output_dim;
    uint slots;
    uint shift_slot;
    uint scale_slot;
    uint gate_slot;
    uint grouped;
};
layout(set = 0, binding = 8) readonly buffer ArgsBuf { H3Args data; } args;

/* ------------------------------------------------------------------ casts */

layout(set = 0, binding = 0) readonly buffer InF32 { float data[]; } in_f32;
layout(set = 0, binding = 1) writeonly buffer OutBF16 { uint16_t data[]; } out_bf16;

#if defined(H3_LS16)
layout(local_size_x = 16, local_size_y = 16) in;
#elif defined(H3_LS128)
layout(local_size_x = 128) in;
#else
layout(local_size_x = 256) in;
#endif
void main_cast_f32_to_bf16() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.count) return;
    out_bf16.data[gid] = uint16_t(h3_f32_to_bf16(in_f32.data[gid]));
}

layout(set = 0, binding = 0) readonly buffer InBF16 { uint16_t data[]; } in_bf16;
layout(set = 0, binding = 1) writeonly buffer OutF32 { float data[]; } out_f32;

void main_cast_bf16_to_f32() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.count) return;
    out_f32.data[gid] = H3_BF16_TO_F32(in_bf16.data[gid]);
}

/* ------------------------------------------------------------------ unary */

void main_silu_f32() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.count) return;
    float value = in_f32.data[gid];
    out_f32.data[gid] = value / (1.0f + exp(-value));
}

void main_silu_bf16() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.count) return;
    float value = H3_BF16_TO_F32(in_bf16.data[gid]);
    out_bf16.data[gid] = uint16_t(h3_f32_to_bf16(value / (1.0f + exp(-value))));
}

layout(set = 0, binding = 1) readonly buffer InBF16B1 { uint16_t data[]; } in_bf16_b1;
layout(set = 0, binding = 2) writeonly buffer OutBF16B2 { uint16_t data[]; } out_bf16_b2;
void main_silu_mul_bf16() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.count) return;
    float value = H3_BF16_TO_F32(in_bf16.data[gid]);
    float other = H3_BF16_TO_F32(in_bf16_b1.data[gid]);
    out_bf16_b2.data[gid] =
        uint16_t(h3_f32_to_bf16(value / (1.0f + exp(-value)) * other));
}

void main_clip_f32() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.elements) return;
    out_f32.data[gid] = clamp(in_f32.data[gid], args.data.minimum, args.data.maximum);
}

void main_gelu_bf16() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.elements) return;
    float value = H3_BF16_TO_F32(in_bf16.data[gid]);
    float activated;
    if (args.data.approximate != 0u) {
        float inner = 0.7978845608028654f *
            (value + 0.044715f * value * value * value);
        activated = inner <= -10.0f ? 0.0f :
                    inner >= 10.0f ? value :
                    0.5f * value * (1.0f + tanh(inner));
    } else {
        float x = abs(value);
        float t = 1.0f / (1.0f + 0.3275911f * x);
        float polynomial = (((((1.061405429f * t - 1.453152027f) * t) +
                               1.421413741f) * t - 0.284496736f) * t +
                               0.254829592f) * t;
        float erf = (value < 0.0f ? -1.0f : 1.0f) *
                    (1.0f - polynomial * exp(-x * x));
        activated = value <= -10.0f ? 0.0f :
                    value >= 10.0f ? value :
                    0.5f * value * (1.0f + erf);
    }
    out_bf16.data[gid] = uint16_t(h3_f32_to_bf16(activated));
}

/* ------------------------------------------------------------------ binary */

void main_add_bf16() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.count) return;
    out_bf16_b2.data[gid] = uint16_t(h3_f32_to_bf16(
        H3_BF16_TO_F32(in_bf16.data[gid]) + H3_BF16_TO_F32(in_bf16_b1.data[gid])));
}

void main_sub_bf16() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.count) return;
    out_bf16_b2.data[gid] = uint16_t(h3_f32_to_bf16(
        H3_BF16_TO_F32(in_bf16.data[gid]) - H3_BF16_TO_F32(in_bf16_b1.data[gid])));
}

layout(set = 0, binding = 1) readonly buffer InF32B1 { float data[]; } in_f32_b1;
layout(set = 0, binding = 2) writeonly buffer OutF32B2 { float data[]; } out_f32_b2;

void main_add_scaled_f32() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.elements) return;
    out_f32_b2.data[gid] = in_f32.data[gid] * args.data.left_scale +
                           in_f32_b1.data[gid] * args.data.right_scale;
}

void main_geglu_f32() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.count) return;
    float x = in_f32.data[gid];
    float cube = x * x * x;
    float gelu = 0.5f * x *
        (1.0f + tanh(0.7978845608028654f * (x + 0.044715f * cube)));
    out_f32_b2.data[gid] = gelu * in_f32_b1.data[gid];
}

/* ------------------------------------------------------------------ euler */

layout(set = 0, binding = 0) buffer SampleBuf { float data[]; } sample_buf;
layout(set = 0, binding = 1) readonly buffer LastBuf { uint16_t data[]; } last_buf;
layout(set = 0, binding = 2) readonly buffer PrevBuf { uint16_t data[]; } prev_buf;

void main_euler_bf16() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.elements) return;
    float last_value = H3_BF16_TO_F32(last_buf.data[gid]);
    float velocity = fma(args.data.ratio,
                         last_value - H3_BF16_TO_F32(prev_buf.data[gid]),
                         last_value);
    uint sample_index = args.data.sample_offset + gid;
    sample_buf.data[sample_index] =
        fma(args.data.delta, velocity, sample_buf.data[sample_index]);
}

/* -------------------------------------------------------------- embedding */

layout(set = 0, binding = 0) readonly buffer EmbW { uint16_t data[]; } emb_w;
layout(set = 0, binding = 1) readonly buffer EmbIds { uint data[]; } emb_ids;
layout(set = 0, binding = 2) writeonly buffer EmbOut { uint16_t data[]; } emb_out;

void main_embedding_bf16() {
    uint gid = gl_GlobalInvocationID.x;
    uint token = gid / args.data.width;
    uint column = gid - token * args.data.width;
    if (token >= args.data.tokens || column >= args.data.width) return;
    uint identifier = emb_ids.data[token];
    emb_out.data[gid] = identifier < args.data.vocab_size ?
        emb_w.data[identifier * args.data.width + column] : uint16_t(0);
}

/* ---------------------------------------------------------------- norms */

layout(set = 0, binding = 0) readonly buffer NormIn { float data[]; } norm_in;
layout(set = 0, binding = 1) readonly buffer NormW { float data[]; } norm_w;
layout(set = 0, binding = 2) writeonly buffer NormOut { float data[]; } norm_out;

shared float norm_reductions[256];

void main_rms_norm_f32() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= args.data.rows) return;
    uint base = row * args.data.width;
    float local_sum = 0.0f;
    for (uint k = tid; k < args.data.width; k += 256u)
        local_sum = fma(norm_in.data[base + k], norm_in.data[base + k],
                        local_sum);
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(norm_reductions[0] / float(args.data.width) +
                                args.data.epsilon);
    for (uint column = tid; column < args.data.width; column += 256u)
        norm_out.data[base + column] =
            norm_in.data[base + column] * inverse * norm_w.data[column];
}

layout(set = 0, binding = 3) readonly buffer NormBias { float data[]; } norm_bias;

void main_layer_norm_f32() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= args.data.rows) return;
    uint base = row * args.data.width;
    float local_sum = 0.0f;
    for (uint k = tid; k < args.data.width; k += 256u)
        local_sum += norm_in.data[base + k];
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float mean = norm_reductions[0] / float(args.data.width);
    barrier();
    local_sum = 0.0f;
    for (uint k = tid; k < args.data.width; k += 256u) {
        float centered = norm_in.data[base + k] - mean;
        local_sum = fma(centered, centered, local_sum);
    }
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(norm_reductions[0] / float(args.data.width) +
                                args.data.epsilon);
    for (uint column = tid; column < args.data.width; column += 256u)
        norm_out.data[base + column] =
            (norm_in.data[base + column] - mean) * inverse *
            norm_w.data[column] + norm_bias.data[column];
}

layout(set = 0, binding = 0) readonly buffer NormInB { uint16_t data[]; } norm_in_b;
layout(set = 0, binding = 1) readonly buffer NormWB { uint16_t data[]; } norm_w_b;
layout(set = 0, binding = 2) writeonly buffer NormOutB { uint16_t data[]; } norm_out_b;

void main_rms_norm_bf16() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= args.data.rows) return;
    uint base = row * args.data.width;
    float local_sum = 0.0f;
    for (uint k = tid; k < args.data.width; k += 256u) {
        float value = H3_BF16_TO_F32(norm_in_b.data[base + k]);
        local_sum = fma(value, value, local_sum);
    }
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(norm_reductions[0] / float(args.data.width) +
                                args.data.epsilon);
    for (uint column = tid; column < args.data.width; column += 256u) {
        float normalized = H3_BF16_TO_F32(norm_in_b.data[base + column]) *
                           inverse;
        norm_out_b.data[base + column] = uint16_t(h3_f32_to_bf16(
            normalized * H3_BF16_TO_F32(norm_w_b.data[column])));
    }
}

layout(set = 0, binding = 3) readonly buffer NormBiasB { uint16_t data[]; } norm_bias_b;

void main_layer_norm_bf16() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= args.data.rows) return;
    uint base = row * args.data.width;
    float local_sum = 0.0f;
    for (uint k = tid; k < args.data.width; k += 256u)
        local_sum += H3_BF16_TO_F32(norm_in_b.data[base + k]);
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float mean = norm_reductions[0] / float(args.data.width);
    barrier();
    local_sum = 0.0f;
    for (uint k = tid; k < args.data.width; k += 256u) {
        float centered = H3_BF16_TO_F32(norm_in_b.data[base + k]) - mean;
        local_sum = fma(centered, centered, local_sum);
    }
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(norm_reductions[0] / float(args.data.width) +
                                args.data.epsilon);
    for (uint column = tid; column < args.data.width; column += 256u) {
        float normalized = (H3_BF16_TO_F32(norm_in_b.data[base + column]) -
                            mean) * inverse;
        float value = fma(normalized, H3_BF16_TO_F32(norm_w_b.data[column]),
                          H3_BF16_TO_F32(norm_bias_b.data[column]));
        norm_out_b.data[base + column] = uint16_t(h3_f32_to_bf16(value));
    }
}


/* ------------------------------------------------------------ linear bf16 */

layout(set = 0, binding = 0) readonly buffer LinIn { uint16_t data[]; } lin_in;
layout(set = 0, binding = 1) readonly buffer LinW { uint16_t data[]; } lin_w;
layout(set = 0, binding = 2) readonly buffer LinB { uint16_t data[]; } lin_b;
layout(set = 0, binding = 3) writeonly buffer LinOut { uint16_t data[]; } lin_out;

shared float lin_input_tile[16][16];
shared float lin_weight_tile[16][16];

void main_linear_bf16() {
    uint column = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
    float sum = (args.data.has_bias != 0u && column < args.data.output_dim) ?
        H3_BF16_TO_F32(lin_b.data[column]) : 0.0f;
    uint tile_count = (args.data.input_dim + 15u) / 16u;
    for (uint tile = 0u; tile < tile_count; tile++) {
        uint input_k = tile * 16u + gl_LocalInvocationID.x;
        lin_input_tile[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            (row < args.data.rows && input_k < args.data.input_dim) ?
            H3_BF16_TO_F32(lin_in.data[row * args.data.input_dim + input_k]) :
            0.0f;
        uint weight_k = tile * 16u + gl_LocalInvocationID.y;
        lin_weight_tile[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            (column < args.data.output_dim && weight_k < args.data.input_dim) ?
            H3_BF16_TO_F32(lin_w.data[column * args.data.input_dim +
                                       weight_k]) : 0.0f;
        barrier();
        for (uint k = 0u; k < 16u; k++) {
            sum = fma(lin_input_tile[gl_LocalInvocationID.y][k],
                      lin_weight_tile[k][gl_LocalInvocationID.x], sum);
        }
        barrier();
    }
    if (row < args.data.rows && column < args.data.output_dim) {
        lin_out.data[row * args.data.output_dim + column] =
            uint16_t(h3_f32_to_bf16(sum));
    }
}

/* Fused [gate | up] halves of one FC1 output: out = silu(gate) * up with a
 * single BF16 rounding, matching h3_shaders.metal's silu_mul semantics. */
layout(set = 0, binding = 0) readonly buffer SwiIn { uint16_t data[]; } swi_in;
layout(set = 0, binding = 1) writeonly buffer SwiOut { uint16_t data[]; } swi_out;

void main_swiglu_halves_bf16() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.elements) return;
    uint row = gid / args.data.width;
    uint column = gid - row * args.data.width;
    uint base = row * args.data.width * 2u;
    float gate = H3_BF16_TO_F32(swi_in.data[base + column]);
    float up = H3_BF16_TO_F32(swi_in.data[base + args.data.width + column]);
    swi_out.data[gid] = uint16_t(h3_f32_to_bf16(
        gate / (1.0f + exp(-gate)) * up));
}


/* -------------------------------------------------------- AdaLN / gates */

layout(set = 0, binding = 0) readonly buffer AdIn { uint16_t data[]; } ad_in;
layout(set = 0, binding = 1) readonly buffer AdW { uint16_t data[]; } ad_w;
layout(set = 0, binding = 2) readonly buffer AdMod { uint16_t data[]; } ad_mod;
layout(set = 0, binding = 3) readonly buffer AdMap { uint data[]; } ad_map;
layout(set = 0, binding = 4) writeonly buffer AdOut { uint16_t data[]; } ad_out;

void main_adaln_bf16() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= args.data.rows) return;
    uint base_row = row * args.data.width;
    float local_sum = 0.0f;
    for (uint k = tid; k < args.data.width; k += 256u) {
        float value = H3_BF16_TO_F32(ad_in.data[base_row + k]);
        local_sum = fma(value, value, local_sum);
    }
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(norm_reductions[0] / float(args.data.width) +
                                args.data.epsilon);
    uint base = ad_map.data[row] * args.data.slots * args.data.width;
    for (uint column = tid; column < args.data.width; column += 256u) {
        float normalized = H3_BF16_TO_F32(ad_in.data[base_row + column]) *
                           inverse * H3_BF16_TO_F32(ad_w.data[column]);
        float shift = H3_BF16_TO_F32(
            ad_mod.data[base + args.data.shift_slot * args.data.width +
                        column]);
        float scale = H3_BF16_TO_F32(
            ad_mod.data[base + args.data.scale_slot * args.data.width +
                        column]);
        ad_out.data[base_row + column] = uint16_t(h3_f32_to_bf16(
            normalized * (1.0f + scale) + shift));
    }
}

layout(set = 0, binding = 0) readonly buffer GateRes { uint16_t data[]; } gate_res;
layout(set = 0, binding = 1) readonly buffer GateBranch { uint16_t data[]; } gate_branch;
layout(set = 0, binding = 2) readonly buffer GateMod { uint16_t data[]; } gate_mod;
layout(set = 0, binding = 3) readonly buffer GateMap { uint data[]; } gate_map;
layout(set = 0, binding = 4) writeonly buffer GateOut { uint16_t data[]; } gate_out;

void main_gate_bf16() {
    uint column = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= args.data.rows || column >= args.data.width) return;
    uint base = gate_map.data[row] * args.data.slots * args.data.width;
    float gate = H3_BF16_TO_F32(
        gate_mod.data[base + args.data.gate_slot * args.data.width + column]);
    uint index = row * args.data.width + column;
    float value = H3_BF16_TO_F32(gate_res.data[index]) +
                  H3_BF16_TO_F32(gate_branch.data[index]) * gate;
    gate_out.data[index] = uint16_t(h3_f32_to_bf16(value));
}

layout(set = 0, binding = 0) readonly buffer GAdRes { uint16_t data[]; } gad_res;
layout(set = 0, binding = 1) readonly buffer GAdBranch { uint16_t data[]; } gad_branch;
layout(set = 0, binding = 2) readonly buffer GAdGMod { uint16_t data[]; } gad_gmod;
layout(set = 0, binding = 3) readonly buffer GAdMap { uint data[]; } gad_map;
layout(set = 0, binding = 4) readonly buffer GAdW { uint16_t data[]; } gad_w;
layout(set = 0, binding = 5) readonly buffer GAdNMod { uint16_t data[]; } gad_nmod;
layout(set = 0, binding = 6) buffer GAdGated { uint16_t data[]; } gad_gated;
layout(set = 0, binding = 7) writeonly buffer GAdOut { uint16_t data[]; } gad_out;

shared uint16_t gated_values[5376];

void main_gate_adaln_bf16() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= args.data.rows) return;
    uint base_row = row * args.data.width;
    uint base = gad_map.data[row] * args.data.slots * args.data.width;
    float local_sum = 0.0f;
    for (uint column = tid; column < args.data.width; column += 256u) {
        uint index = base_row + column;
        float gate = H3_BF16_TO_F32(
            gad_gmod.data[base + args.data.gate_slot * args.data.width +
                          column]);
        uint16_t gated = uint16_t(h3_f32_to_bf16(
            H3_BF16_TO_F32(gad_res.data[index]) +
            H3_BF16_TO_F32(gad_branch.data[index]) * gate));
        gad_gated.data[index] = gated;
        gated_values[column] = gated;
        float value = H3_BF16_TO_F32(gated);
        local_sum = fma(value, value, local_sum);
    }
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(norm_reductions[0] / float(args.data.width) +
                                args.data.epsilon);
    for (uint column = tid; column < args.data.width; column += 256u) {
        float normalized = H3_BF16_TO_F32(gated_values[column]) * inverse *
                           H3_BF16_TO_F32(gad_w.data[column]);
        float shift = H3_BF16_TO_F32(
            gad_nmod.data[base + args.data.shift_slot * args.data.width +
                          column]);
        float scale = H3_BF16_TO_F32(
            gad_nmod.data[base + args.data.scale_slot * args.data.width +
                          column]);
        gad_out.data[base_row + column] = uint16_t(h3_f32_to_bf16(
            normalized * (1.0f + scale) + shift));
    }
}

/* Inverse RMS scalars for the fused final projection (rows floats). */
layout(set = 0, binding = 0) readonly buffer RmsIn { uint16_t data[]; } rms_in;
layout(set = 0, binding = 1) writeonly buffer RmsInv { float data[]; } rms_inv;

void main_rms_inverse_bf16() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= args.data.rows) return;
    uint base_row = row * args.data.width;
    float local_sum = 0.0f;
    for (uint k = tid; k < args.data.width; k += 256u) {
        float value = H3_BF16_TO_F32(rms_in.data[base_row + k]);
        local_sum = fma(value, value, local_sum);
    }
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    if (tid == 0u) {
        rms_inv.data[row] = inversesqrt(norm_reductions[0] /
                                        float(args.data.width) +
                                        args.data.epsilon);
    }
}

/* Fused final AdaLN + 16x16 linear (see h3_adaln_linear_bf16 in the Metal
 * source): the normalized activation is rounded to BF16 before the dot
 * product, preserving the AdaLN + linear arithmetic boundary. */
layout(set = 0, binding = 0) readonly buffer ALIn { uint16_t data[]; } al_in;
layout(set = 0, binding = 1) readonly buffer ALInv { float data[]; } al_inv;
layout(set = 0, binding = 2) readonly buffer ALNW { uint16_t data[]; } al_nw;
layout(set = 0, binding = 3) readonly buffer ALMod { uint16_t data[]; } al_mod;
layout(set = 0, binding = 4) readonly buffer ALMap { uint data[]; } al_map;
layout(set = 0, binding = 5) readonly buffer ALW { uint16_t data[]; } al_w;
layout(set = 0, binding = 6) readonly buffer ALB { uint16_t data[]; } al_b;
layout(set = 0, binding = 7) writeonly buffer ALOut { uint16_t data[]; } al_out;

void main_adaln_linear_bf16() {
    uint column = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
    float sum = (args.data.has_bias != 0u && column < args.data.output_dim) ?
        H3_BF16_TO_F32(al_b.data[column]) : 0.0f;
    uint base = row < args.data.rows ?
        al_map.data[row] * args.data.slots * args.data.width : 0u;
    uint tile_count = (args.data.width + 15u) / 16u;
    for (uint tile = 0u; tile < tile_count; tile++) {
        uint input_k = tile * 16u + gl_LocalInvocationID.x;
        uint16_t normalized = uint16_t(0);
        if (row < args.data.rows && input_k < args.data.width) {
            float value = H3_BF16_TO_F32(
                al_in.data[row * args.data.width + input_k]);
            float shift = H3_BF16_TO_F32(
                al_mod.data[base + args.data.shift_slot * args.data.width +
                            input_k]);
            float scale = H3_BF16_TO_F32(
                al_mod.data[base + args.data.scale_slot * args.data.width +
                            input_k]);
            float normed = value * al_inv.data[row] *
                           H3_BF16_TO_F32(al_nw.data[input_k]);
            normalized = uint16_t(h3_f32_to_bf16(normed * (1.0f + scale) +
                                                 shift));
        }
        lin_input_tile[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            H3_BF16_TO_F32(normalized);
        uint weight_k = tile * 16u + gl_LocalInvocationID.y;
        lin_weight_tile[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            (column < args.data.output_dim && weight_k < args.data.width) ?
            H3_BF16_TO_F32(al_w.data[column * args.data.width + weight_k]) :
            0.0f;
        barrier();
        for (uint k = 0u; k < 16u; k++) {
            sum = fma(lin_input_tile[gl_LocalInvocationID.y][k],
                      lin_weight_tile[k][gl_LocalInvocationID.x], sum);
        }
        barrier();
    }
    if (row < args.data.rows && column < args.data.output_dim) {
        al_out.data[row * args.data.output_dim + column] =
            uint16_t(h3_f32_to_bf16(sum));
    }
}

/* Per-head RMS norm in place (Qwen3 style). */
layout(set = 0, binding = 0) buffer HNIn { uint16_t data[]; } hn_in;
layout(set = 0, binding = 1) readonly buffer HNW { uint16_t data[]; } hn_w;

void main_head_rms_norm_bf16() {
    uint row = gl_GlobalInvocationID.x;
    uint head = gl_GlobalInvocationID.y;
    if (row >= args.data.rows || head >= args.data.width) return;
    uint base = (row * args.data.width + head) * args.data.input_dim;
    float sum = 0.0f;
    for (uint d = 0u; d < args.data.input_dim; d++) {
        float value = H3_BF16_TO_F32(hn_in.data[base + d]);
        sum = fma(value, value, sum);
    }
    float inverse = inversesqrt(sum / float(args.data.input_dim) +
                                args.data.epsilon);
    for (uint d = 0u; d < args.data.input_dim; d++) {
        float value = H3_BF16_TO_F32(hn_in.data[base + d]);
        hn_in.data[base + d] = uint16_t(h3_f32_to_bf16(
            value * inverse * H3_BF16_TO_F32(hn_w.data[d])));
    }
}





/* --------------------------------------------------------- QKV + SDPA */

layout(set = 0, binding = 0) readonly buffer QKVIn { uint16_t data[]; } qkv_in;
layout(set = 0, binding = 1) readonly buffer QNorm { uint16_t data[]; } q_norm;
layout(set = 0, binding = 2) readonly buffer KNorm { uint16_t data[]; } k_norm;
layout(set = 0, binding = 3) readonly buffer RopeCos { uint16_t data[]; } rope_cos;
layout(set = 0, binding = 4) readonly buffer RopeSin { uint16_t data[]; } rope_sin;
layout(set = 0, binding = 5) writeonly buffer QueryOut { uint16_t data[]; } query_out;
layout(set = 0, binding = 6) writeonly buffer KeyOut { uint16_t data[]; } key_out;
layout(set = 0, binding = 7) writeonly buffer ValueOut { uint16_t data[]; } value_out;

/* Checkpoint QKV rows are [head, q/k/v, dimension] when grouped, or
 * [q/k/v, head, dimension] otherwise. Applies per-head Q/K RMS norm and
 * the +/-half RoPE rotation, writing [row, head, dimension] heads. */
void main_grouped_qkv_rope_bf16() {
    uint dimension = gl_GlobalInvocationID.x;
    uint head = gl_GlobalInvocationID.y;
    uint row = gl_GlobalInvocationID.z;
    if (dimension >= args.data.input_dim || head >= args.data.width ||
        row >= args.data.rows)
        return;
    uint inner = args.data.width * args.data.input_dim;
    uint row_base = row * inner * 3u;
    uint q_base = row_base + head * args.data.input_dim;
    uint k_base = q_base + inner;
    uint v_base = q_base + inner * 2u;
    if (args.data.grouped != 0u) {
        q_base = row_base + head * args.data.input_dim * 3u;
        k_base = q_base + args.data.input_dim;
        v_base = k_base + args.data.input_dim;
    }
    float q_sum = 0.0f;
    float k_sum = 0.0f;
    for (uint d = 0u; d < args.data.input_dim; d++) {
        float q = H3_BF16_TO_F32(qkv_in.data[q_base + d]);
        float k = H3_BF16_TO_F32(qkv_in.data[k_base + d]);
        q_sum = fma(q, q, q_sum);
        k_sum = fma(k, k, k_sum);
    }
    float q_inverse = inversesqrt(q_sum / float(args.data.input_dim) +
                                  args.data.epsilon);
    float k_inverse = inversesqrt(k_sum / float(args.data.input_dim) +
                                  args.data.epsilon);
    float q0 = H3_BF16_TO_F32(qkv_in.data[q_base + dimension]) * q_inverse *
               H3_BF16_TO_F32(q_norm.data[dimension]);
    float k0 = H3_BF16_TO_F32(qkv_in.data[k_base + dimension]) * k_inverse *
               H3_BF16_TO_F32(k_norm.data[dimension]);
    if (dimension < args.data.output_dim) {
        uint pair = dimension + args.data.output_dim;
        float q1 = H3_BF16_TO_F32(qkv_in.data[q_base + pair]) * q_inverse *
                   H3_BF16_TO_F32(q_norm.data[pair]);
        float k1 = H3_BF16_TO_F32(qkv_in.data[k_base + pair]) * k_inverse *
                   H3_BF16_TO_F32(k_norm.data[pair]);
        float c = H3_BF16_TO_F32(rope_cos.data[row * args.data.output_dim +
                                               dimension]);
        float s = H3_BF16_TO_F32(rope_sin.data[row * args.data.output_dim +
                                               dimension]);
        q0 = q0 * c - q1 * s;
        k0 = k0 * c - k1 * s;
    } else if (dimension < args.data.output_dim * 2u) {
        uint pair = dimension - args.data.output_dim;
        float q1 = H3_BF16_TO_F32(qkv_in.data[q_base + pair]) * q_inverse *
                   H3_BF16_TO_F32(q_norm.data[pair]);
        float k1 = H3_BF16_TO_F32(qkv_in.data[k_base + pair]) * k_inverse *
                   H3_BF16_TO_F32(k_norm.data[pair]);
        float c = H3_BF16_TO_F32(rope_cos.data[row * args.data.output_dim +
                                               pair]);
        float s = H3_BF16_TO_F32(rope_sin.data[row * args.data.output_dim +
                                               pair]);
        q0 = q0 * c + q1 * s;
        k0 = k0 * c + k1 * s;
    }
    uint output_index = (row * args.data.width + head) * args.data.input_dim +
                        dimension;
    query_out.data[output_index] = uint16_t(h3_f32_to_bf16(q0));
    key_out.data[output_index] = uint16_t(h3_f32_to_bf16(k0));
    value_out.data[output_index] = qkv_in.data[v_base + dimension];
}

/* Portable SDPA: one thread per (row, head), naive softmax with maximum
 * subtraction and F32 accumulation. The Metal backend uses MPSGraph here;
 * the reference semantics are the same. With grouped != 0 the output is
 * written in native [head, row, dimension] order for a layout-aware
 * projection. */
layout(set = 0, binding = 0) readonly buffer SdpaQ { uint16_t data[]; } sdpa_q;
layout(set = 0, binding = 1) readonly buffer SdpaK { uint16_t data[]; } sdpa_k;
layout(set = 0, binding = 2) readonly buffer SdpaV { uint16_t data[]; } sdpa_v;
layout(set = 0, binding = 3) writeonly buffer SdpaOut { uint16_t data[]; } sdpa_out;

void main_sdpa_bf16() {
    uint head = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    uint seq = args.data.rows;
    uint heads = args.data.width;
    uint dim = args.data.input_dim;
    if (row >= seq || head >= heads) return;
    float scale = args.data.left_scale;
    uint qbase = (row * heads + head) * dim;
    float maxv = -3.402823466e+38f;
    for (uint s = 0u; s < seq; s++) {
        uint kbase = (s * heads + head) * dim;
        float dot = 0.0f;
        for (uint d = 0u; d < dim; d++) {
            dot = fma(H3_BF16_TO_F32(sdpa_q.data[qbase + d]),
                      H3_BF16_TO_F32(sdpa_k.data[kbase + d]), dot);
        }
        dot *= scale;
        maxv = max(maxv, dot);
    }
    float sum = 0.0f;
    for (uint s = 0u; s < seq; s++) {
        uint kbase = (s * heads + head) * dim;
        float dot = 0.0f;
        for (uint d = 0u; d < dim; d++) {
            dot = fma(H3_BF16_TO_F32(sdpa_q.data[qbase + d]),
                      H3_BF16_TO_F32(sdpa_k.data[kbase + d]), dot);
        }
        sum += exp(dot * scale - maxv);
    }
    for (uint d = 0u; d < dim; d++) {
        float acc = 0.0f;
        for (uint s = 0u; s < seq; s++) {
            uint kbase = (s * heads + head) * dim;
            float dot = 0.0f;
            for (uint k = 0u; k < dim; k++) {
                dot = fma(H3_BF16_TO_F32(sdpa_q.data[qbase + k]),
                          H3_BF16_TO_F32(sdpa_k.data[kbase + k]), dot);
            }
            acc = fma(exp(dot * scale - maxv),
                      H3_BF16_TO_F32(sdpa_v.data[kbase + d]), acc);
        }
        uint oindex = args.data.grouped != 0u ?
            (head * seq + row) * dim + d : qbase + d;
        sdpa_out.data[oindex] = uint16_t(h3_f32_to_bf16(acc / sum));
    }
}



/* ------------------------------------------------------- patch linear */

layout(set = 0, binding = 0) readonly buffer PIn { float data[]; } p_in;
layout(set = 0, binding = 1) readonly buffer PW { float data[]; } p_w;
layout(set = 0, binding = 2) readonly buffer PB { float data[]; } p_b;
layout(set = 0, binding = 3) writeonly buffer POut { uint16_t data[]; } p_out;

/* F32 patch projection (video 96->5376, audio 32->5376) writing BF16
 * directly into the packed hidden stream. */
void main_patch_linear_bf16() {
    uint column = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
    float sum = (args.data.has_bias != 0u && column < args.data.output_dim) ?
        p_b.data[column] : 0.0f;
    uint tile_count = (args.data.input_dim + 15u) / 16u;
    for (uint tile = 0u; tile < tile_count; tile++) {
        uint input_k = tile * 16u + gl_LocalInvocationID.x;
        lin_input_tile[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            (row < args.data.rows && input_k < args.data.input_dim) ?
            p_in.data[row * args.data.input_dim + input_k] : 0.0f;
        uint weight_k = tile * 16u + gl_LocalInvocationID.y;
        lin_weight_tile[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            (column < args.data.output_dim && weight_k < args.data.input_dim) ?
            p_w.data[column * args.data.input_dim + weight_k] : 0.0f;
        barrier();
        for (uint k = 0u; k < 16u; k++) {
            sum = fma(lin_input_tile[gl_LocalInvocationID.y][k],
                      lin_weight_tile[k][gl_LocalInvocationID.x], sum);
        }
        barrier();
    }
    if (row < args.data.rows && column < args.data.output_dim) {
        p_out.data[row * args.data.output_dim + column] =
            uint16_t(h3_f32_to_bf16(sum));
    }
}

/* Mapped variant: row_map compacts destination rows (FL2VA/Ref2VA packed
 * layouts), read once per threadgroup row. */
layout(set = 0, binding = 0) readonly buffer PMIn { float data[]; } pm_in;
layout(set = 0, binding = 1) readonly buffer PMW { float data[]; } pm_w;
layout(set = 0, binding = 2) readonly buffer PMB { float data[]; } pm_b;
layout(set = 0, binding = 3) writeonly buffer PMOut { uint16_t data[]; } pm_out;
layout(set = 0, binding = 4) readonly buffer PMMap { uint data[]; } pm_map;

shared uint patch_output_rows[16];

void main_patch_linear_bf16_map() {
    uint column = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
    uint row = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
    if (gl_LocalInvocationID.x == 0u) {
        patch_output_rows[gl_LocalInvocationID.y] =
            row < args.data.rows ? pm_map.data[row] : 0u;
    }
    barrier();
    float sum = (args.data.has_bias != 0u && column < args.data.output_dim) ?
        pm_b.data[column] : 0.0f;
    uint tile_count = (args.data.input_dim + 15u) / 16u;
    for (uint tile = 0u; tile < tile_count; tile++) {
        uint input_k = tile * 16u + gl_LocalInvocationID.x;
        lin_input_tile[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            (row < args.data.rows && input_k < args.data.input_dim) ?
            pm_in.data[row * args.data.input_dim + input_k] : 0.0f;
        uint weight_k = tile * 16u + gl_LocalInvocationID.y;
        lin_weight_tile[gl_LocalInvocationID.y][gl_LocalInvocationID.x] =
            (column < args.data.output_dim && weight_k < args.data.input_dim) ?
            pm_w.data[column * args.data.input_dim + weight_k] : 0.0f;
        barrier();
        for (uint k = 0u; k < 16u; k++) {
            sum = fma(lin_input_tile[gl_LocalInvocationID.y][k],
                      lin_weight_tile[k][gl_LocalInvocationID.x], sum);
        }
        barrier();
    }
    if (row < args.data.rows && column < args.data.output_dim) {
        pm_out.data[patch_output_rows[gl_LocalInvocationID.y] *
                    args.data.output_dim + column] =
            uint16_t(h3_f32_to_bf16(sum));
    }
}



/* Flash-style SDPA: one 128-thread workgroup per (row, head), each thread
 * owning one head dimension. Online softmax (running max and sum) with F32
 * accumulation; per-source dot products use the same tree reduction order
 * as the norm kernels. Selected automatically for sequences of at least
 * 128 rows, where the one-thread-per-output naive kernel would serialize. */
layout(set = 0, binding = 0) readonly buffer FlQ { uint16_t data[]; } fl_q;
layout(set = 0, binding = 1) readonly buffer FlK { uint16_t data[]; } fl_k;
layout(set = 0, binding = 2) readonly buffer FlV { uint16_t data[]; } fl_v;
layout(set = 0, binding = 3) writeonly buffer FlOut { uint16_t data[]; } fl_out;

shared float fl_q_shared[128];
shared float fl_dots[128];
shared float fl_acc[128];
shared float fl_max;
shared float fl_old_max;
shared float fl_sum;

void main_sdpa_flash_bf16() {
    uint head = gl_WorkGroupID.x;
    uint row = gl_WorkGroupID.y;
    uint d = gl_LocalInvocationID.x;
    uint seq = args.data.rows;
    uint heads = args.data.width;
    uint dim = args.data.input_dim;
    if (row >= seq || head >= heads || d >= dim) return;
    float scale = args.data.left_scale;
    uint qbase = (row * heads + head) * dim;
    fl_q_shared[d] = H3_BF16_TO_F32(fl_q.data[qbase + d]);
    fl_acc[d] = 0.0f;
    if (d == 0u) {
        fl_max = -3.402823466e+38f;
        fl_sum = 0.0f;
    }
    barrier();
    for (uint s = 0u; s < seq; s++) {
        uint kbase = (s * heads + head) * dim;
        fl_dots[d] = fma(fl_q_shared[d],
                         H3_BF16_TO_F32(fl_k.data[kbase + d]), 0.0f);
        barrier();
        for (uint stride = 64u; stride > 0u; stride >>= 1) {
            if (d < stride) fl_dots[d] += fl_dots[d + stride];
            barrier();
        }
        float dot = fl_dots[0] * scale;
        if (d == 0u) {
            float new_max = max(fl_max, dot);
            fl_old_max = fl_max;
            fl_max = new_max;
            fl_sum = fl_sum * exp(fl_old_max - new_max) +
                     exp(dot - new_max);
        }
        barrier();
        float p = exp(fl_old_max - fl_max);
        float w = exp(fl_dots[0] * scale - fl_max);
        fl_acc[d] = fl_acc[d] * p +
                    w * H3_BF16_TO_F32(fl_v.data[kbase + d]);
        barrier();
    }
    uint oindex = args.data.grouped != 0u ?
        (head * seq + row) * dim + d : qbase + d;
    fl_out.data[oindex] = uint16_t(h3_f32_to_bf16(fl_acc[d] / fl_sum));
}

/* The runtime compiles one module per kernel with H3_ENTRY selecting the
 * kernel function; glslc testing uses -DH3_ENTRY=main_<kernel>. */
void main() { H3_ENTRY(); }
