    }
    coopMatStore(gate_accumulator, cm8_accumulator,
                 subgroup * 16u * 16u, 16u,
                 gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    coopmat<int, gl_ScopeSubgroup, 16, 16,
            gl_MatrixUseAccumulator> up_accumulator =
        coopmat<int, gl_ScopeSubgroup, 16, 16,
                gl_MatrixUseAccumulator>(0);
    for (uint tile = 0u; tile < args.data.input_dim; tile += 32u) {
        for (uint index = tid; index < 16u * 32u; index += 256u) {
            uint tile_row = index / 32u;
            uint tile_k = index - tile_row * 32u;
            uint row = row_start + tile_row;
            uint k = tile + tile_k;
            cm8_input[index] = row < args.data.rows &&
                               k < args.data.input_dim ?
                l8_in.data[row * args.data.input_dim + k] : int8_t(0);
        }
        for (uint index = tid; index < 8u * 16u * 32u; index += 256u) {
            uint subgroup_tile = index / (16u * 32u);
            uint within = index - subgroup_tile * 16u * 32u;
            uint tile_column = within / 32u;
            uint tile_k = within - tile_column * 32u;
            uint column = column_group + subgroup_tile * 16u + tile_column;
            uint k = tile + tile_k;
            cm8_weight[index] = column < hidden &&
                                k < args.data.input_dim ?
                l8_w.data[(hidden + column) * args.data.input_dim + k] :
                int8_t(0);
        }
        barrier();
        coopmat<int8_t, gl_ScopeSubgroup, 16, 32,
                gl_MatrixUseA> input_matrix;
        coopmat<int8_t, gl_ScopeSubgroup, 32, 16,
                gl_MatrixUseB> up_matrix;
        coopMatLoad(input_matrix, cm8_input, 0u, 32u,
                    gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(up_matrix, cm8_weight,
                    subgroup * 16u * 32u, 32u,
                    gl_CooperativeMatrixLayoutColumnMajor);
        up_accumulator =
            coopMatMulAdd(input_matrix, up_matrix, up_accumulator);
        barrier();
    }
    coopMatStore(up_accumulator, cmfc_accumulator_up,
                 subgroup * 16u * 16u, 16u,
                 gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint index = tid; index < 8u * 16u * 16u; index += 256u) {
        uint subgroup_tile = index / (16u * 16u);
        uint within = index - subgroup_tile * 16u * 16u;
        uint tile_row = within / 16u;
        uint tile_column = within - tile_row * 16u;
        uint row = row_start + tile_row;
        uint column = column_group + subgroup_tile * 16u + tile_column;
        if (row < args.data.rows && column < hidden) {
            float input_scale = l8_is.data[row];
            float gate = H3_BF16_TO_F32(h3_f32_to_bf16(
                float(cm8_accumulator[index]) * input_scale *
                l8_ws.data[column]));
            float up = float(cmfc_accumulator_up[index]) * input_scale *
                       l8_ws.data[hidden + column];
            l8_out.data[row * hidden + column] = uint16_t(h3_f32_to_bf16(
                gate / (1.0f + exp(-gate)) * up));
        }
    }
}

/* Grouped FC2 Tensor-Core path. Each 1024-wide activation group gets an
 * independent exact int32 matrix accumulation before reference-order F32
 * dequantization. */
void main_linear_int8_grouped_coop_bf16() {
    uint tid = gl_LocalInvocationID.x;
    uint subgroup = gl_SubgroupID;
    uint row_start = gl_WorkGroupID.y * 16u;
    uint column_group = gl_WorkGroupID.x * 128u;
    float totals[8];
    for (uint slot = 0u; slot < 8u; slot++) totals[slot] = 0.0f;
    uint groups = args.data.elements;
    uint group_size = args.data.width;
    for (uint group = 0u; group < groups; group++) {
        coopmat<int, gl_ScopeSubgroup, 16, 16,
                gl_MatrixUseAccumulator> accumulator =
            coopmat<int, gl_ScopeSubgroup, 16, 16,
                    gl_MatrixUseAccumulator>(0);
        uint group_begin = group * group_size;
        uint group_end = min(group_begin + group_size, args.data.input_dim);
        for (uint tile = group_begin; tile < group_end; tile += 32u) {
            for (uint index = tid; index < 16u * 32u; index += 256u) {
                uint tile_row = index / 32u;
                uint tile_k = index - tile_row * 32u;
                uint row = row_start + tile_row;
                uint k = tile + tile_k;
                cm8_input[index] = row < args.data.rows && k < group_end ?
                    l8_in.data[row * args.data.input_dim + k] : int8_t(0);
            }
            for (uint index = tid; index < 8u * 16u * 32u; index += 256u) {
                uint subgroup_tile = index / (16u * 32u);
                uint within = index - subgroup_tile * 16u * 32u;
                uint tile_column = within / 32u;
                uint tile_k = within - tile_column * 32u;
                uint column =
                    column_group + subgroup_tile * 16u + tile_column;
                uint k = tile + tile_k;
                cm8_weight[index] = column < args.data.output_dim &&
                                    k < group_end ?
                    l8_w.data[column * args.data.input_dim + k] : int8_t(0);
            }
            barrier();
            coopmat<int8_t, gl_ScopeSubgroup, 16, 32,
                    gl_MatrixUseA> input_matrix;
            coopmat<int8_t, gl_ScopeSubgroup, 32, 16,
                    gl_MatrixUseB> weight_matrix;
            coopMatLoad(input_matrix, cm8_input, 0u, 32u,
                        gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(weight_matrix, cm8_weight,
                        subgroup * 16u * 32u, 32u,
                        gl_CooperativeMatrixLayoutColumnMajor);
            accumulator =
                coopMatMulAdd(input_matrix, weight_matrix, accumulator);
            barrier();
        }
        coopMatStore(accumulator, cm8_accumulator,
                     subgroup * 16u * 16u, 16u,
                     gl_CooperativeMatrixLayoutRowMajor);
        barrier();
        for (uint slot = 0u; slot < 8u; slot++) {
            uint index = tid + slot * 256u;
            uint subgroup_tile = index / (16u * 16u);
            uint within = index - subgroup_tile * 16u * 16u;
            uint tile_row = within / 16u;
            uint tile_column = within - tile_row * 16u;
            uint row = row_start + tile_row;
            uint column = column_group +
                          subgroup_tile * 16u + tile_column;
            if (row < args.data.rows && column < args.data.output_dim)
                totals[slot] += float(cm8_accumulator[index]) *
                    l8_is.data[row * groups + group] * l8_ws.data[column];
        }
        barrier();
    }
    for (uint slot = 0u; slot < 8u; slot++) {
        uint index = tid + slot * 256u;
        uint subgroup_tile = index / (16u * 16u);
        uint within = index - subgroup_tile * 16u * 16u;
        uint tile_row = within / 16u;
        uint tile_column = within - tile_row * 16u;
        uint row = row_start + tile_row;
        uint column = column_group + subgroup_tile * 16u + tile_column;
        if (row < args.data.rows && column < args.data.output_dim)
            l8_out.data[row * args.data.output_dim + column] =
                uint16_t(h3_f32_to_bf16(totals[slot]));
    }
}
#endif

/* Grouped FC2 (Metal h3_linear_int8_grouped_nax_r128x64): one int
 * accumulator per 1024-wide input group, dequantized per group and summed
 * in f32 with a single BF16 rounding, matching the reference order
 * (acc * input_scale) * weight_scale. */
void main_linear_int8_grouped_bf16() {
    uint local_column = gl_LocalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint column_base = gl_WorkGroupID.x * 16u + local_column;
    uint row = gl_WorkGroupID.y * 32u + local_row;
    uint groups = args.data.elements;
    uint group_size = args.data.width;
    if (groups > 16u) return;
    int acc[2][16];
    for (uint part = 0u; part < 2u; part++)
        for (uint group = 0u; group < groups; group++)
            acc[part][group] = 0;
    uint tile_count = (args.data.input_dim + 31u) / 32u;
    for (uint tile = 0u; tile < tile_count; tile++) {
        for (uint part = 0u; part < 4u; part++) {
            uint tile_k = local_column + part * 8u;
            uint input_k = tile * 32u + tile_k;
            lin8_in_tile[local_row][tile_k] =
                row < args.data.rows && input_k < args.data.input_dim ?
                l8_in.data[row * args.data.input_dim + input_k] : int8_t(0);
        }
        uint weight_k = tile * 32u + local_row;
        for (uint part = 0u; part < 2u; part++) {
            uint column = column_base + part * 8u;
            lin8_w_tile[local_row][local_column + part * 8u] =
                column < args.data.output_dim &&
                weight_k < args.data.input_dim ?
                l8_w.data[column * args.data.input_dim + weight_k] :
                int8_t(0);
        }
        barrier();
        uint group = (tile * 32u) / group_size;
        for (uint k = 0u; k < 32u; k++) {
            int input_value = int(lin8_in_tile[local_row][k]);
            for (uint part = 0u; part < 2u; part++)
                acc[part][group] += input_value *
                    int(lin8_w_tile[k][local_column + part * 8u]);
        }
        barrier();
    }
    if (row < args.data.rows) {
        for (uint part = 0u; part < 2u; part++) {
            uint column = column_base + part * 8u;
            if (column >= args.data.output_dim) continue;
            float total = 0.0f;
            for (uint group = 0u; group < groups; group++)
                total += float(acc[part][group]) *
                         l8_is.data[row * groups + group] *
                         l8_ws.data[column];
            l8_out.data[row * args.data.output_dim + column] =
                uint16_t(h3_f32_to_bf16(total));
        }
    }
}

/* F32 sibling of the flash kernel: one workgroup per (head, row) with an
 * online-softmax sweep over the sequence; used for long sequences where
 * the one-thread-per-output naive kernel would trip the GPU watchdog. */
layout(set = 0, binding = 0) readonly buffer SdpFFQ { float data[]; } flf_q;
layout(set = 0, binding = 1) readonly buffer SdpFFK { float data[]; } flf_k;
layout(set = 0, binding = 2) readonly buffer SdpFFV { float data[]; } flf_v;
layout(set = 0, binding = 3) writeonly buffer SdpFFOut { float data[]; } flf_out;

void main_sdpa_flash_f32() {
    uint head = gl_WorkGroupID.x;
    uint row = gl_WorkGroupID.y;
    uint d = gl_LocalInvocationID.x;
    uint seq = args.data.rows;
    uint heads = args.data.width;
    uint dim = args.data.input_dim;
    if (row >= seq || head >= heads) return;
    float scale = args.data.left_scale;
    uint qbase = (row * heads + head) * dim;
    fl_q_shared[d] = d < dim ? flf_q.data[qbase + d] : 0.0f;
    fl_acc[d] = 0.0f;
    if (d == 0u) {
        fl_max = -3.402823466e+38f;
        fl_sum = 0.0f;
    }
    barrier();
    for (uint s = 0u; s < seq; s++) {
        uint kbase = (s * heads + head) * dim;
        fl_dots[d] = d < dim ?
            fma(fl_q_shared[d], flf_k.data[kbase + d], 0.0f) : 0.0f;
        barrier();
        for (uint stride = 64u; stride > 0u; stride >>= 1) {
            if (d < stride) fl_dots[d] += fl_dots[d + stride];
            barrier();
        }
        float dot = fl_dots[0] * scale;
        if (d == 0u) {
            float new_max = max(fl_max, dot);
            fl_old_max = fl_max;
            fl_max = new_max;
            fl_sum = fl_sum * exp(fl_old_max - new_max) +
                     exp(dot - new_max);
        }
        barrier();
        float p = exp(fl_old_max - fl_max);
        float w = exp(fl_dots[0] * scale - fl_max);
        float value = d < dim ? flf_v.data[kbase + d] : 0.0f;
        fl_acc[d] = fl_acc[d] * p + w * value;
        barrier();
    }
    if (d < dim) {
        uint oindex = args.data.grouped != 0u ?
            (head * seq + row) * dim + d : qbase + d;
        flf_out.data[oindex] = fl_acc[d] / fl_sum;
    }
}

/* F32 version of the 16-query tiled SDPA. K/V tiles are shared by sixteen
 * queries and QK uses ascending-dimension FMA order. */
void main_sdpa_tiled_f32() {
    uint local_query = gl_LocalInvocationID.y;
    uint local_key = gl_LocalInvocationID.x;
    uint tid = local_query * 16u + local_key;
    uint query_start = gl_WorkGroupID.x * 16u;
    uint head = gl_WorkGroupID.y;
    uint seq = args.data.rows;
    uint heads = args.data.width;
    uint dim = args.data.input_dim;
    uint tile_elements = 16u * dim;
    float output_values[8];
    for (uint slot = 0u; slot < 8u; slot++) output_values[slot] = 0.0f;

    for (uint index = tid; index < tile_elements; index += 256u) {
        uint tile_row = index / dim;
        uint dimension = index - tile_row * dim;
        uint row = query_start + tile_row;
        sdt_query[tile_row][dimension] =
            row < seq && head < heads ?
            flf_q.data[(row * heads + head) * dim + dimension] : 0.0f;
    }
    if (tid < 16u) {
        sdt_row_maximum[tid] = -3.402823466e+38f;
        sdt_row_sum[tid] = 0.0f;
        sdt_row_alpha[tid] = 0.0f;
    }
    barrier();

    for (uint key_start = 0u; key_start < seq; key_start += 16u) {
        for (uint index = tid; index < tile_elements; index += 256u) {
            uint tile_row = index / dim;
            uint dimension = index - tile_row * dim;
            uint row = key_start + tile_row;
            uint source = (row * heads + head) * dim + dimension;
            sdt_key[dimension][tile_row] =
                row < seq && head < heads ? flf_k.data[source] : 0.0f;
            sdt_value[tile_row][dimension] =
                row < seq && head < heads ? flf_v.data[source] : 0.0f;
        }
        barrier();

        float score = 0.0f;
        for (uint dimension = 0u; dimension < dim; dimension++)
            score = fma(sdt_query[local_query][dimension],
                        sdt_key[dimension][local_key], score);
        sdt_scores[local_query][local_key] = score * args.data.left_scale;
        barrier();

        if (tid < 16u) {
            uint valid_keys = min(16u, seq - key_start);
            float tile_maximum = -3.402823466e+38f;
            for (uint column = 0u; column < valid_keys; column++)
                tile_maximum = max(tile_maximum, sdt_scores[tid][column]);
            float old_maximum = sdt_row_maximum[tid];
            float new_maximum = max(old_maximum, tile_maximum);
            float alpha = sdt_row_sum[tid] > 0.0f ?
                          exp(old_maximum - new_maximum) : 0.0f;
            float tile_sum = 0.0f;
            for (uint column = 0u; column < 16u; column++) {
                float probability = column < valid_keys ?
                    exp(sdt_scores[tid][column] - new_maximum) : 0.0f;
                sdt_probabilities[tid][column] = probability;
                tile_sum += probability;
            }
            sdt_row_alpha[tid] = alpha;
            sdt_row_sum[tid] = sdt_row_sum[tid] * alpha + tile_sum;
            sdt_row_maximum[tid] = new_maximum;
        }
        barrier();

        for (uint slot = 0u; slot < 8u; slot++) {
            uint index = tid + slot * 256u;
            if (index < tile_elements) {
                uint tile_row = index / dim;
                uint dimension = index - tile_row * dim;
                float partial = 0.0f;
                for (uint column = 0u; column < 16u; column++)
                    partial = fma(sdt_probabilities[tile_row][column],
                                  sdt_value[column][dimension], partial);
                output_values[slot] =
                    fma(output_values[slot], sdt_row_alpha[tile_row], partial);
            }
        }
        barrier();
    }

    for (uint slot = 0u; slot < 8u; slot++) {
        uint index = tid + slot * 256u;
        if (index < tile_elements) {
            uint tile_row = index / dim;
            uint dimension = index - tile_row * dim;
            uint row = query_start + tile_row;
            if (row < seq && head < heads)
                flf_out.data[(row * heads + head) * dim + dimension] =
                    output_values[slot] / sdt_row_sum[tile_row];
        }
    }
}

/* -------------------------------------------------------- token pool */

layout(set = 0, binding = 0) readonly buffer TpIn { uint16_t data[]; } tp_in;
layout(set = 0, binding = 1) readonly buffer TpPairs { uvec2 data[]; } tp_pairs;
layout(set = 0, binding = 2) writeonly buffer TpOut { uint16_t data[]; } tp_out;
layout(set = 0, binding = 3) writeonly buffer TpBase { uint16_t data[]; } tp_base;
layout(set = 0, binding = 4) readonly buffer TpBaseIdx { uint data[]; } tp_base_idx;
layout(set = 0, binding = 5) writeonly buffer TpOrig { uint16_t data[]; } tp_orig;

/* Pool adjacent horizontal token pairs into `rows` rows, snapshotting both
 * source rows into the full-resolution bypass. Singleton pairs (x == y)
 * repeat their source index so non-video prefixes stay bit exact. */
void main_token_pool_bf16() {
    uint column = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= args.data.rows || column >= args.data.width) return;
    uvec2 pair = tp_pairs.data[row];
    uint16_t first = tp_in.data[args.data.sample_offset +
                                pair.x * args.data.width + column];
    tp_orig.data[args.data.tokens + pair.x * args.data.width + column] =
        first;
    uint16_t pooled = first;
    if (pair.x != pair.y) {
        uint16_t second = tp_in.data[args.data.sample_offset +
                                     pair.y * args.data.width + column];
        tp_orig.data[args.data.tokens + pair.y * args.data.width + column] =
            second;
        float average = (H3_BF16_TO_F32(first) + H3_BF16_TO_F32(second)) *
                        0.5f;
        pooled = uint16_t(h3_f32_to_bf16(average));
    }
    tp_out.data[row * args.data.width + column] = pooled;
    uint baseline_index = tp_base_idx.data[row];
    if (baseline_index != 0xffffffffu) {
        tp_base.data[args.data.vocab_size +
                     baseline_index * args.data.width + column] = pooled;
    }
}

layout(set = 0, binding = 6) readonly buffer TpW { uint16_t data[]; } tp_w;
layout(set = 0, binding = 7) readonly buffer TpMod { uint16_t data[]; } tp_mod;
layout(set = 0, binding = 8) readonly buffer TpMap { uint data[]; } tp_map;
layout(set = 0, binding = 9) writeonly buffer TpAdOut { uint16_t data[]; } tp_adout;

/* Pooling fused with the first reduced block's attention AdaLN: the pooled
 * row stays in threadgroup memory for the norm. */
void main_token_pool_adaln_bf16() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= args.data.rows) return;
    uvec2 pair = tp_pairs.data[row];
    uint baseline_index = tp_base_idx.data[row];
    float local_sum = 0.0f;
    for (uint column = tid; column < args.data.width; column += 256u) {
        uint16_t first = tp_in.data[args.data.sample_offset +
                                    pair.x * args.data.width + column];
        tp_orig.data[args.data.tokens + pair.x * args.data.width + column] =
            first;
        uint16_t pooled = first;
        if (pair.x != pair.y) {
            uint16_t second = tp_in.data[args.data.sample_offset +
                                         pair.y * args.data.width + column];
            tp_orig.data[args.data.tokens +
                         pair.y * args.data.width + column] = second;
            pooled = uint16_t(h3_f32_to_bf16(
                (H3_BF16_TO_F32(first) + H3_BF16_TO_F32(second)) * 0.5f));
        }
        uint destination = row * args.data.width + column;
        tp_out.data[destination] = pooled;
        gated_values[column] = pooled;
        if (baseline_index != 0xffffffffu) {
            tp_base.data[args.data.vocab_size +
                         baseline_index * args.data.width + column] = pooled;
        }
        float value = H3_BF16_TO_F32(pooled);
        local_sum = fma(value, value, local_sum);
    }
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(norm_reductions[0] / float(args.data.width) +
                                args.data.epsilon);
    uint base = tp_map.data[row] * args.data.slots * args.data.width;
    for (uint column = tid; column < args.data.width; column += 256u) {
        float normalized = H3_BF16_TO_F32(gated_values[column]) * inverse *
                           H3_BF16_TO_F32(tp_w.data[column]);
        float shift = H3_BF16_TO_F32(
            tp_mod.data[base + args.data.shift_slot * args.data.width +
                        column]);
        float scale = H3_BF16_TO_F32(
            tp_mod.data[base + args.data.scale_slot * args.data.width +
                        column]);
        tp_adout.data[row * args.data.width + column] =
            uint16_t(h3_f32_to_bf16(normalized * (1.0f + scale) + shift));
    }
}

layout(set = 0, binding = 0) readonly buffer TxOrig { uint16_t data[]; } tx_orig;
layout(set = 0, binding = 1) readonly buffer TxReduced { uint16_t data[]; } tx_reduced;
layout(set = 0, binding = 2) readonly buffer TxBase { uint16_t data[]; } tx_base;
layout(set = 0, binding = 3) readonly buffer TxBaseIdx { uint data[]; } tx_base_idx;
layout(set = 0, binding = 4) readonly buffer TxParents { uint data[]; } tx_parents;
layout(set = 0, binding = 5) writeonly buffer TxOut { uint16_t data[]; } tx_out;

/* Restore the full grid: reduced rows contribute only their update relative
 * to the pooled baseline, keeping the original within-pair detail. */
void main_token_expand_delta_bf16() {
    uint column = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= args.data.rows || column >= args.data.width) return;
    uint parent = tx_parents.data[row];
    uint destination = row * args.data.width + column;
    uint reduced_index = parent * args.data.width + column;
    if (row < args.data.elements) {
        tx_out.data[destination] = tx_reduced.data[reduced_index];
        return;
    }
    uint baseline_row = tx_base_idx.data[parent];
    if (baseline_row == 0xffffffffu) {
        tx_out.data[destination] = tx_reduced.data[reduced_index];
        return;
    }
    uint baseline_index = args.data.vocab_size +
                          baseline_row * args.data.width + column;
    float update = H3_BF16_TO_F32(tx_reduced.data[reduced_index]) -
                   H3_BF16_TO_F32(tx_base.data[baseline_index]);
    tx_out.data[destination] = uint16_t(h3_f32_to_bf16(
        H3_BF16_TO_F32(tx_orig.data[args.data.tokens + destination]) +
        args.data.left_scale * update));
}

layout(set = 0, binding = 6) readonly buffer TxW { uint16_t data[]; } tx_w;
layout(set = 0, binding = 7) readonly buffer TxMod { uint16_t data[]; } tx_mod;
layout(set = 0, binding = 8) readonly buffer TxMap { uint data[]; } tx_map;
layout(set = 0, binding = 9) writeonly buffer TxAdOut { uint16_t data[]; } tx_adout;

/* Expansion fused with the first full-resolution block's attention AdaLN. */
void main_token_expand_adaln_bf16() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (row >= args.data.rows) return;
    uint parent = tx_parents.data[row];
    uint baseline_row = tx_base_idx.data[parent];
    bool direct = row < args.data.elements ||
                  baseline_row == 0xffffffffu;
    float local_sum = 0.0f;
    for (uint column = tid; column < args.data.width; column += 256u) {
        uint destination = row * args.data.width + column;
        uint reduced_index = parent * args.data.width + column;
        uint16_t restored = tx_reduced.data[reduced_index];
        if (!direct) {
            uint baseline_index = args.data.vocab_size +
                                  baseline_row * args.data.width + column;
            float update = H3_BF16_TO_F32(restored) -
                           H3_BF16_TO_F32(tx_base.data[baseline_index]);
            restored = uint16_t(h3_f32_to_bf16(
                H3_BF16_TO_F32(tx_orig.data[args.data.tokens + destination]) +
                args.data.left_scale * update));
        }
        gated_values[column] = restored;
        tx_out.data[destination] = restored;
        float value = H3_BF16_TO_F32(restored);
        local_sum = fma(value, value, local_sum);
    }
    norm_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) norm_reductions[tid] += norm_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(norm_reductions[0] / float(args.data.width) +
                                args.data.epsilon);
    uint base = tx_map.data[row] * args.data.slots * args.data.width;
    for (uint column = tid; column < args.data.width; column += 256u) {
        float normalized = H3_BF16_TO_F32(gated_values[column]) * inverse *
                           H3_BF16_TO_F32(tx_w.data[column]);
        float shift = H3_BF16_TO_F32(
            tx_mod.data[base + args.data.shift_slot * args.data.width +
                        column]);
        float scale = H3_BF16_TO_F32(
            tx_mod.data[base + args.data.scale_slot * args.data.width +
                        column]);
        tx_adout.data[row * args.data.width + column] =
            uint16_t(h3_f32_to_bf16(normalized * (1.0f + scale) + shift));
    }
}



/* ------------------------------------------------------- Qwen encoder */

layout(set = 0, binding = 0) readonly buffer TQIn { uint16_t data[]; } tq_in;
layout(set = 0, binding = 1) readonly buffer TKIn { uint16_t data[]; } tk_in;
layout(set = 0, binding = 2) readonly buffer TQW { uint16_t data[]; } tq_w;
layout(set = 0, binding = 3) readonly buffer TKW { uint16_t data[]; } tk_w;
layout(set = 0, binding = 4) readonly buffer TQRC { uint16_t data[]; } tq_rc;
layout(set = 0, binding = 5) readonly buffer TQRS { uint16_t data[]; } tq_rs;
layout(set = 0, binding = 6) writeonly buffer TQOut { uint16_t data[]; } tq_out;
layout(set = 0, binding = 7) writeonly buffer TKOut { uint16_t data[]; } tk_out;

/* Qwen3 text Q/K RMS + RoPE from separate inputs; KV heads share one
 * key/value projection, so the key branch runs only for head < kv_heads. */
void main_text_qk_rope_bf16() {
    uint dimension = gl_GlobalInvocationID.x;
    uint head = gl_GlobalInvocationID.y;
    uint row = gl_GlobalInvocationID.z;
    uint query_heads = args.data.width;
    uint kv_heads = args.data.input_dim;
    uint head_dim = args.data.output_dim;
    if (dimension >= head_dim || head >= query_heads ||
        row >= args.data.rows)
        return;
    uint half_dim = head_dim / 2u;
    uint pair = dimension < half_dim ? dimension + half_dim :
                                        dimension - half_dim;
    float c = H3_BF16_TO_F32(tq_rc.data[row * half_dim +
                                        (dimension % half_dim)]);
    float s = H3_BF16_TO_F32(tq_rs.data[row * half_dim +
                                        (dimension % half_dim)]);
    uint q_base = (row * query_heads + head) * head_dim;
    float q_sum = 0.0f;
    for (uint d = 0u; d < head_dim; d++) {
        float value = H3_BF16_TO_F32(tq_in.data[q_base + d]);
        q_sum = fma(value, value, q_sum);
    }
    float q_inverse = inversesqrt(q_sum / float(head_dim) +
                                  args.data.epsilon);
    float q0 = H3_BF16_TO_F32(tq_in.data[q_base + dimension]) * q_inverse *
               H3_BF16_TO_F32(tq_w.data[dimension]);
    float q1 = H3_BF16_TO_F32(tq_in.data[q_base + pair]) * q_inverse *
               H3_BF16_TO_F32(tq_w.data[pair]);
    float q_rotated = dimension < half_dim ? q0 * c - q1 * s :
                                             q0 * c + q1 * s;
    tq_out.data[q_base + dimension] = uint16_t(h3_f32_to_bf16(q_rotated));
    if (head < kv_heads) {
        uint k_base = (row * kv_heads + head) * head_dim;
        float k_sum = 0.0f;
        for (uint d = 0u; d < head_dim; d++) {
            float value = H3_BF16_TO_F32(tk_in.data[k_base + d]);
            k_sum = fma(value, value, k_sum);
        }
        float k_inverse = inversesqrt(k_sum / float(head_dim) +
                                      args.data.epsilon);
        float k0 = H3_BF16_TO_F32(tk_in.data[k_base + dimension]) *
                   k_inverse * H3_BF16_TO_F32(tk_w.data[dimension]);
        float k1 = H3_BF16_TO_F32(tk_in.data[k_base + pair]) * k_inverse *
                   H3_BF16_TO_F32(tk_w.data[pair]);
        float k_rotated = dimension < half_dim ? k0 * c - k1 * s :
                                                 k0 * c + k1 * s;
        tk_out.data[k_base + dimension] = uint16_t(h3_f32_to_bf16(k_rotated));
    }
}

/* In-place Iris-style RoPE with F32 tables. */
layout(set = 0, binding = 0) buffer TRQ { uint16_t data[]; } tr_q;
layout(set = 0, binding = 1) buffer TRK { uint16_t data[]; } tr_k;
layout(set = 0, binding = 2) readonly buffer TRC { float data[]; } tr_c;
layout(set = 0, binding = 3) readonly buffer TRS { float data[]; } tr_s;

void main_rope_text_bf16() {
    uint row = gl_GlobalInvocationID.x;
    uint head = gl_GlobalInvocationID.y;
    uint query_heads = args.data.width;
    uint kv_heads = args.data.input_dim;
    uint head_dim = args.data.output_dim;
    if (row >= args.data.rows) return;
    uint half_dim = head_dim / 2u;
    if (head < query_heads) {
        uint base = (row * query_heads + head) * head_dim;
        for (uint d = 0u; d < half_dim; d++) {
            float first = H3_BF16_TO_F32(tr_q.data[base + d]);
            float second = H3_BF16_TO_F32(tr_q.data[base + half_dim + d]);
            float c = tr_c.data[row * half_dim + d];
            float s = tr_s.data[row * half_dim + d];
            tr_q.data[base + d] = uint16_t(h3_f32_to_bf16(first * c -
                                                          second * s));
            tr_q.data[base + half_dim + d] =
                uint16_t(h3_f32_to_bf16(second * c + first * s));
        }
    }
    if (head < kv_heads) {
        uint base = (row * kv_heads + head) * head_dim;
        for (uint d = 0u; d < half_dim; d++) {
            float first = H3_BF16_TO_F32(tr_k.data[base + d]);
            float second = H3_BF16_TO_F32(tr_k.data[base + half_dim + d]);
            float c = tr_c.data[row * half_dim + d];
            float s = tr_s.data[row * half_dim + d];
            tr_k.data[base + d] = uint16_t(h3_f32_to_bf16(first * c -
                                                          second * s));
            tr_k.data[base + half_dim + d] =
                uint16_t(h3_f32_to_bf16(second * c + first * s));
        }
    }
}

/* Causal GQA attention (Qwen3 text decoder). The scale is applied to Q
 * before the contraction, matching MLX's fused SDPA order. Sequences through
 * 4096 keep the original full-score arithmetic; longer contexts use tiled
 * online softmax with bounded threadgroup memory. */
layout(set = 0, binding = 0) readonly buffer GqQ { uint16_t data[]; } gq_q;
layout(set = 0, binding = 1) readonly buffer GqK { uint16_t data[]; } gq_k;
layout(set = 0, binding = 2) readonly buffer GqV { uint16_t data[]; } gq_v;
layout(set = 0, binding = 3) writeonly buffer GqOut { uint16_t data[]; } gq_out;

shared float gq_scores[4096];
shared float gq_reductions[128];
shared float gq_shared_query[128];
shared float gq_online_state[3];

void main_gqa_causal_bf16() {
    uint query_row = gl_WorkGroupID.x;
    uint query_head = gl_WorkGroupID.y;
    uint tid = gl_LocalInvocationID.x;
    uint seq = args.data.rows;
    uint query_heads = args.data.width;
    uint kv_heads = args.data.input_dim;
    uint head_dim = args.data.output_dim;
    if (query_row >= seq || query_head >= query_heads) return;
    uint kv_head = query_head / (query_heads / kv_heads);
    uint q_base = (query_row * query_heads + query_head) * head_dim;
    uint key_count = query_row + 1;
    for (uint d = tid; d < head_dim; d += 128u) {
        gq_shared_query[d] = H3_BF16_TO_F32(uint16_t(h3_f32_to_bf16(
            H3_BF16_TO_F32(gq_q.data[q_base + d]) * args.data.left_scale)));
    }
    barrier();

    if (seq > 4096u) {
        float accumulator = 0.0f;
        if (tid == 0u) {
            gq_online_state[0] = -3.402823466e+38f;
            gq_online_state[1] = 0.0f;
            gq_online_state[2] = 0.0f;
        }
        barrier();
        for (uint tile_start = 0u; tile_start < key_count;
             tile_start += 128u) {
            uint key_row = tile_start + tid;
            float dot = -3.402823466e+38f;
            if (key_row < key_count) {
                uint k_base =
                    (key_row * kv_heads + kv_head) * head_dim;
                dot = 0.0f;
                for (uint d = 0u; d < head_dim; d++) {
                    dot = fma(gq_shared_query[d],
                              H3_BF16_TO_F32(gq_k.data[k_base + d]), dot);
                }
            }
            gq_scores[tid] = dot;
            gq_reductions[tid] = dot;
            barrier();
            for (uint stride = 64u; stride > 0u; stride >>= 1) {
                if (tid < stride)
                    gq_reductions[tid] = max(
                        gq_reductions[tid],
                        gq_reductions[tid + stride]);
                barrier();
            }
            if (tid == 0u) {
                float previous_max = gq_online_state[0];
                float maximum = max(previous_max, gq_reductions[0]);
                gq_online_state[2] = gq_online_state[1] > 0.0f ?
                    exp(previous_max - maximum) : 0.0f;
                gq_online_state[0] = maximum;
            }
            barrier();
            float probability = key_row < key_count ?
                exp(gq_scores[tid] - gq_online_state[0]) : 0.0f;
            gq_scores[tid] = probability;
            gq_reductions[tid] = probability;
            barrier();
            for (uint stride = 64u; stride > 0u; stride >>= 1) {
                if (tid < stride)
                    gq_reductions[tid] += gq_reductions[tid + stride];
                barrier();
            }
            if (tid == 0u) {
                gq_online_state[1] =
                    gq_online_state[1] * gq_online_state[2] +
                    gq_reductions[0];
            }
            barrier();
            if (tid < head_dim) {
                uint tile_count = key_count - tile_start;
                if (tile_count > 128u) tile_count = 128u;
                float tile_sum = 0.0f;
                for (uint offset = 0u; offset < tile_count; offset++) {
                    uint v_index =
                        ((tile_start + offset) * kv_heads + kv_head) *
                        head_dim + tid;
                    tile_sum = fma(gq_scores[offset],
                                   H3_BF16_TO_F32(gq_v.data[v_index]),
                                   tile_sum);
                }
                accumulator = fma(accumulator, gq_online_state[2], tile_sum);
            }
            barrier();
        }
        if (tid < head_dim) {
            gq_out.data[q_base + tid] = uint16_t(h3_f32_to_bf16(
                accumulator / gq_online_state[1]));
        }
        return;
    }

    float local_max = -3.402823466e+38f;
    for (uint key_row = tid; key_row < key_count; key_row += 128u) {
        uint k_base = (key_row * kv_heads + kv_head) * head_dim;
        float dot = 0.0f;
        for (uint d = 0u; d < head_dim; d++) {
            dot = fma(gq_shared_query[d],
                      H3_BF16_TO_F32(gq_k.data[k_base + d]), dot);
        }
        gq_scores[key_row] = dot;
        local_max = max(local_max, dot);
    }
    gq_reductions[tid] = local_max;
    barrier();
    for (uint stride = 64u; stride > 0u; stride >>= 1) {
        if (tid < stride)
            gq_reductions[tid] = max(gq_reductions[tid],
                                     gq_reductions[tid + stride]);
        barrier();
    }
    float maximum = gq_reductions[0];
    float local_sum = 0.0f;
    for (uint key_row = tid; key_row < key_count; key_row += 128u) {
        float probability = exp(gq_scores[key_row] - maximum);
        gq_scores[key_row] = probability;
        local_sum += probability;
    }
    gq_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 64u; stride > 0u; stride >>= 1) {
        if (tid < stride) gq_reductions[tid] += gq_reductions[tid + stride];
        barrier();
    }
    float inverse_sum = 1.0f / gq_reductions[0];
    for (uint d = tid; d < head_dim; d += 128u) {
        float sum = 0.0f;
        for (uint key_row = 0u; key_row < key_count; key_row++) {
            uint v_index = (key_row * kv_heads + kv_head) * head_dim + d;
            sum = fma(gq_scores[key_row] * inverse_sum,
                      H3_BF16_TO_F32(gq_v.data[v_index]), sum);
        }
        gq_out.data[q_base + d] = uint16_t(h3_f32_to_bf16(sum));
    }
}

/* ------------------------------------------------------------- linear f32 */

layout(set = 0, binding = 0) readonly buffer LFIn { float data[]; } lf_in;
layout(set = 0, binding = 1) readonly buffer LFW { float data[]; } lf_w;
layout(set = 0, binding = 2) readonly buffer LFB { float data[]; } lf_b;
layout(set = 0, binding = 3) writeonly buffer LFOut { float data[]; } lf_out;

void main_linear_f32() {
    uint column = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= args.data.rows || column >= args.data.output_dim) return;
    float sum = args.data.has_bias != 0u ? lf_b.data[column] : 0.0f;
    for (uint k = 0u; k < args.data.input_dim; k++) {
        sum = fma(lf_in.data[row * args.data.input_dim + k],
                  lf_w.data[column * args.data.input_dim + k], sum);
    }
    lf_out.data[row * args.data.output_dim + column] = sum;
}

/* Shared-memory GEMM with the same ascending-K FMA order as the scalar
 * oracle. Each 16x16 input and weight tile is fetched once instead of once
 * per output element. Padding the K stride avoids shared-memory bank
 * conflicts when a subgroup reads different output rows of the weight tile. */
shared float lft_input_tile[64][17];
shared float lft_weight_tile[64][17];

void main_linear_f32_tiled() {
    uint local_k = gl_LocalInvocationID.x;
    uint local_index = gl_LocalInvocationID.y;
    uint row_base = gl_WorkGroupID.y * 64u + local_index;
    uint column_base = gl_WorkGroupID.x * 64u + local_k;
    float sums[16];
    for (uint row_part = 0u; row_part < 4u; row_part++) {
        for (uint column_part = 0u; column_part < 4u; column_part++) {
            uint column = column_base + column_part * 16u;
            sums[row_part * 4u + column_part] =
                args.data.has_bias != 0u && column < args.data.output_dim ?
                lf_b.data[column] : 0.0f;
        }
    }
    for (uint tile = 0u; tile < args.data.input_dim; tile += 16u) {
        uint k = tile + local_k;
        for (uint part = 0u; part < 4u; part++) {
            uint offset = local_index + part * 16u;
            uint row = gl_WorkGroupID.y * 64u + offset;
            uint weight_row = gl_WorkGroupID.x * 64u + offset;
            lft_input_tile[offset][local_k] =
                row < args.data.rows && k < args.data.input_dim ?
                lf_in.data[row * args.data.input_dim + k] : 0.0f;
            lft_weight_tile[offset][local_k] =
                weight_row < args.data.output_dim && k < args.data.input_dim ?
                lf_w.data[weight_row * args.data.input_dim + k] : 0.0f;
        }
        barrier();
        uint count = min(16u, args.data.input_dim - tile);
        for (uint inner = 0u; inner < count; inner++) {
            float inputs[4];
            float weights[4];
            for (uint part = 0u; part < 4u; part++) {
                inputs[part] =
                    lft_input_tile[local_index + part * 16u][inner];
                weights[part] =
                    lft_weight_tile[local_k + part * 16u][inner];
            }
            for (uint row_part = 0u; row_part < 4u; row_part++)
                for (uint column_part = 0u; column_part < 4u; column_part++)
                    sums[row_part * 4u + column_part] =
                        fma(inputs[row_part], weights[column_part],
                            sums[row_part * 4u + column_part]);
        }
        barrier();
    }
    for (uint row_part = 0u; row_part < 4u; row_part++) {
        uint row = row_base + row_part * 16u;
        if (row >= args.data.rows) continue;
        for (uint column_part = 0u; column_part < 4u; column_part++) {
            uint column = column_base + column_part * 16u;
            if (column < args.data.output_dim)
                lf_out.data[row * args.data.output_dim + column] =
                    sums[row_part * 4u + column_part];
        }
    }
}

/* ---------------------------------------------------------- scale-add f32 */

layout(set = 0, binding = 0) readonly buffer SRes { float data[]; } s_res;
layout(set = 0, binding = 1) readonly buffer SBranch { float data[]; } s_branch;
layout(set = 0, binding = 2) readonly buffer SScale { float data[]; } s_scale;
layout(set = 0, binding = 3) writeonly buffer SOut { float data[]; } s_out;

void main_scale_add_f32() {
    uint column = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= args.data.rows || column >= args.data.width) return;
    uint index = row * args.data.width + column;
    s_out.data[index] = fma(s_branch.data[index], s_scale.data[column],
                            s_res.data[index]);
}

/* ------------------------------------------------------------- swiglu f32 */

layout(set = 0, binding = 0) readonly buffer SwiFIn { float data[]; } swif_in;
layout(set = 0, binding = 1) writeonly buffer SwiFOut { float data[]; } swif_out;

void main_swiglu_f32() {
    uint column = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= args.data.rows || column >= args.data.width) return;
    uint base = row * args.data.width * 2u;
    float gate = swif_in.data[base + column];
    float up = swif_in.data[base + args.data.width + column];
    swif_out.data[row * args.data.width + column] =
        gate / (1.0f + exp(-gate)) * up;
}

/* ------------------------------------------------------ video QKV norm/rope */

layout(set = 0, binding = 0) readonly buffer VQKV { float data[]; } vqkv_in;
layout(set = 0, binding = 1) readonly buffer VCos { float data[]; } vcos;
layout(set = 0, binding = 2) readonly buffer VSin { float data[]; } vsin;
layout(set = 0, binding = 3) writeonly buffer VQ { float data[]; } vq_out;
layout(set = 0, binding = 4) writeonly buffer VK { float data[]; } vk_out;
layout(set = 0, binding = 5) writeonly buffer VV { float data[]; } vv_out;

void main_video_qkv_rope_f32() {
    uint dimension = gl_GlobalInvocationID.x;
    uint head = gl_GlobalInvocationID.y;
    uint row = gl_GlobalInvocationID.z;
    uint head_dim = args.data.input_dim;
    uint heads = args.data.width;
    uint sequence = args.data.rows;
    uint rope_half = args.data.output_dim;
    if (dimension >= head_dim || head >= heads || row >= sequence) return;
    uint base = (row * heads + head) * head_dim * 3u;
    float q_sum = 0.0f, k_sum = 0.0f;
    for (uint d = 0u; d < head_dim; d++) {
        float q = vqkv_in.data[base + d];
        float k = vqkv_in.data[base + head_dim + d];
        q_sum = fma(q, q, q_sum);
        k_sum = fma(k, k, k_sum);
    }
    float qi = inversesqrt(q_sum / float(head_dim) + args.data.epsilon);
    float ki = inversesqrt(k_sum / float(head_dim) + args.data.epsilon);
    float q0 = vqkv_in.data[base + dimension] * qi;
    float k0 = vqkv_in.data[base + head_dim + dimension] * ki;
    if (dimension < rope_half) {
        uint pair = dimension + rope_half;
        float q1 = vqkv_in.data[base + pair] * qi;
        float k1 = vqkv_in.data[base + head_dim + pair] * ki;
        float c = vcos.data[row * rope_half + dimension];
        float s = vsin.data[row * rope_half + dimension];
        q0 = q0 * c - q1 * s;
        k0 = k0 * c - k1 * s;
    } else if (dimension < rope_half * 2u) {
        uint pair = dimension - rope_half;
        float q1 = vqkv_in.data[base + pair] * qi;
        float k1 = vqkv_in.data[base + head_dim + pair] * ki;
        float c = vcos.data[row * rope_half + pair];
        float s = vsin.data[row * rope_half + pair];
        q0 = q0 * c + q1 * s;
        k0 = k0 * c + k1 * s;
    }
    uint output_index = (row * heads + head) * head_dim + dimension;
    vq_out.data[output_index] = q0;
    vk_out.data[output_index] = k0;
    vv_out.data[output_index] = vqkv_in.data[base + head_dim * 2u + dimension];
}

/* ------------------------------------------------------- VAE encoder pad f32 */

layout(set = 0, binding = 0) readonly buffer VPadIn { float data[]; } vpad_in;
layout(set = 0, binding = 1) writeonly buffer VPadOut { float data[]; } vpad_out;

void main_vae_encoder_pad_f32() {
    uint channel = gl_GlobalInvocationID.x;
    uint out_x = gl_GlobalInvocationID.y;
    uint plane = gl_GlobalInvocationID.z;
    uint depth = args.data.conv_depth;
    uint height = args.data.conv_height;
    uint width = args.data.conv_width;
    uint channels = args.data.conv_in_channels;
    uint depth_front = args.data.pad_depth_front;
    uint height_before = args.data.pad_height_before;
    uint height_after = args.data.pad_height_after;
    uint width_before = args.data.pad_width_before;
    uint width_after = args.data.pad_width_after;
    uint out_height = height + height_before + height_after;
    uint out_width = width + width_before + width_after;
    uint out_depth = depth + depth_front;
    if (channel >= channels || out_x >= out_width ||
        plane >= args.data.conv_batch * out_depth * out_height) return;
    uint out_y = plane % out_height;
    uint temporal_plane = plane / out_height;
    uint out_t = temporal_plane % out_depth;
    uint batch = temporal_plane / out_depth;
    uint destination = ((((batch * out_depth + out_t) * out_height + out_y) *
                         out_width + out_x) * channels + channel);
    if (out_t < depth_front) {
        vpad_out.data[destination] = 0.0f;
        return;
    }
    int source_y = int(out_y) - int(height_before);
    if (source_y < 0) source_y = -source_y;
    if (source_y >= int(height))
        source_y = 2 * int(height) - source_y - 2;
    int source_x = int(out_x) - int(width_before);
    if (source_x < 0) source_x = -source_x;
    if (source_x >= int(width))
        source_x = 2 * int(width) - source_x - 2;
    uint source_t = out_t - depth_front;
    uint source = ((((batch * depth + source_t) * height + uint(source_y)) *
                    width + uint(source_x)) * channels + channel);
    vpad_out.data[destination] = vpad_in.data[source];
}

/* ------------------------------------------- VAE encoder group norm + silu */

layout(set = 0, binding = 0) readonly buffer GNIn { float data[]; } gn_in;
layout(set = 0, binding = 1) readonly buffer GNW { float data[]; } gn_w;
layout(set = 0, binding = 2) readonly buffer GNB { float data[]; } gn_b;
layout(set = 0, binding = 3) writeonly buffer GNOut { float data[]; } gn_out;

shared float gn_reductions[256];

void main_vae_encoder_group_norm_silu_f32() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint groups = args.data.conv_out_channels;
    uint channels = args.data.conv_in_channels;
    uint height = args.data.conv_height;
    uint width = args.data.conv_width;
    uint rows = args.data.conv_batch * args.data.conv_depth * groups;
    if (row >= rows) return;
    uint channels_per_group = channels / groups;
    uint group_index = row % groups;
    uint temporal_plane = row / groups;
    uint elements = height * width * channels_per_group;
    float local = 0.0f;
    for (uint index = tid; index < elements; index += 256u) {
        uint spatial = index / channels_per_group;
        uint channel = group_index * channels_per_group +
                       index % channels_per_group;
        uint source = (temporal_plane * height * width + spatial) * channels +
                      channel;
        local += gn_in.data[source];
    }
    gn_reductions[tid] = local;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) gn_reductions[tid] += gn_reductions[tid + stride];
        barrier();
    }
    float mean = gn_reductions[0] / float(elements);
    local = 0.0f;
    for (uint index = tid; index < elements; index += 256u) {
        uint spatial = index / channels_per_group;
        uint channel = group_index * channels_per_group +
                       index % channels_per_group;
        uint source = (temporal_plane * height * width + spatial) * channels +
                      channel;
        float centered = gn_in.data[source] - mean;
        local = fma(centered, centered, local);
    }
    gn_reductions[tid] = local;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) gn_reductions[tid] += gn_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(gn_reductions[0] / float(elements) +
                                args.data.epsilon);
    for (uint index = tid; index < elements; index += 256u) {
        uint spatial = index / channels_per_group;
        uint channel = group_index * channels_per_group +
                       index % channels_per_group;
        uint destination =
            (temporal_plane * height * width + spatial) * channels + channel;
        float value = (gn_in.data[destination] - mean) * inverse *
                          gn_w.data[channel] +
                      gn_b.data[channel];
        gn_out.data[destination] = value / (1.0f + exp(-value));
    }
}

/* --------------------------------------------------------------- sdpa f32 */

layout(set = 0, binding = 0) readonly buffer SdpFQ { float data[]; } sdpf_q;
layout(set = 0, binding = 1) readonly buffer SdpFK { float data[]; } sdpf_k;
layout(set = 0, binding = 2) readonly buffer SdpFV { float data[]; } sdpf_v;
layout(set = 0, binding = 3) writeonly buffer SdpFOut { float data[]; } sdpf_out;

void main_sdpa_f32() {
    uint head = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    uint seq = args.data.rows;
    uint heads = args.data.width;
    uint dim = args.data.input_dim;
    if (row >= seq || head >= heads) return;
    float scale = args.data.left_scale;
    uint qbase = (row * heads + head) * dim;
    float maxv = -3.402823466e+38f;
    for (uint s = 0u; s < seq; s++) {
        uint kbase = (s * heads + head) * dim;
        float dot = 0.0f;
        for (uint d = 0u; d < dim; d++) {
            dot = fma(sdpf_q.data[qbase + d], sdpf_k.data[kbase + d], dot);
        }
        dot *= scale;
        maxv = max(maxv, dot);
    }
    float sum = 0.0f;
    for (uint s = 0u; s < seq; s++) {
        uint kbase = (s * heads + head) * dim;
        float dot = 0.0f;
        for (uint d = 0u; d < dim; d++) {
            dot = fma(sdpf_q.data[qbase + d], sdpf_k.data[kbase + d], dot);
        }
        sum += exp(dot * scale - maxv);
    }
    for (uint d = 0u; d < dim; d++) {
        float acc = 0.0f;
        for (uint s = 0u; s < seq; s++) {
            uint kbase = (s * heads + head) * dim;
            float dot = 0.0f;
            for (uint k = 0u; k < dim; k++) {
                dot = fma(sdpf_q.data[qbase + k],
                          sdpf_k.data[kbase + k], dot);
            }
            acc = fma(exp(dot * scale - maxv), sdpf_v.data[kbase + d], acc);
        }
        uint oindex = args.data.grouped != 0u ?
            (head * seq + row) * dim + d : qbase + d;
        sdpf_out.data[oindex] = acc / sum;
    }
}

/* --------------------------------------------------------------- conv3d f32 */

layout(set = 0, binding = 0) readonly buffer CvIn { float data[]; } cv_in;
layout(set = 0, binding = 1) readonly buffer CvW { float data[]; } cv_w;
layout(set = 0, binding = 2) readonly buffer CvB { float data[]; } cv_b;
layout(set = 0, binding = 3) writeonly buffer CvOut { float data[]; } cv_out;

void main_conv3d_f32() {
    uint out_x = gl_GlobalInvocationID.x;
    uint oc = gl_GlobalInvocationID.y;
    uint plane = gl_GlobalInvocationID.z;
    uint batch = args.data.conv_batch;
    uint depth = args.data.conv_depth;
    uint height = args.data.conv_height;
    uint width = args.data.conv_width;
    uint in_channels = args.data.conv_in_channels;
    uint out_channels = args.data.conv_out_channels;
    uint kd = args.data.conv_kernel_depth;
    uint kh = args.data.conv_kernel_height;
    uint kw = args.data.conv_kernel_width;
    uint sd = args.data.conv_stride_depth;
    uint sh = args.data.conv_stride_height;
    uint sw = args.data.conv_stride_width;
    uint output_depth = (depth - kd) / sd + 1u;
    uint output_height = (height - kh) / sh + 1u;
    uint output_width = (width - kw) / sw + 1u;
    uint spatial = plane % (output_depth * output_height);
    uint out_t = spatial / output_height;
    uint out_h = spatial % output_height;
    uint batch_index = plane / (output_depth * output_height);
    if (batch_index >= batch || out_t >= output_depth ||
        out_h >= output_height || out_x >= output_width ||
        oc >= out_channels) return;
    float sum = args.data.has_bias != 0u ? cv_b.data[oc] : 0.0f;
    for (uint kt = 0u; kt < kd; kt++) {
        for (uint khh = 0u; khh < kh; khh++) {
            for (uint kww = 0u; kww < kw; kww++) {
                for (uint ic = 0u; ic < in_channels; ic++) {
                    uint in_t = out_t * sd + kt;
                    uint in_h = out_h * sh + khh;
                    uint in_x = out_x * sw + kww;
                    uint input_index =
                        ((((batch_index * depth + in_t) * height + in_h) *
                          width + in_x) * in_channels + ic);
                    uint weight_index =
                        ((((oc * in_channels + ic) * kd + kt) * kh +
                          khh) * kw + kww);
                    sum = fma(cv_in.data[input_index],
                              cv_w.data[weight_index], sum);
                }
            }
        }
    }
    uint output_index =
        ((((batch_index * output_depth + out_t) * output_height + out_h) *
          output_width + out_x) * out_channels + oc);
    cv_out.data[output_index] = sum;
}

/* --------------------------------------------------------- audio family */

/* weight_norm: out[row, :] = vector[row, :] * magnitude[row] / ||vector|| */

layout(set = 0, binding = 0) readonly buffer WNVec { float data[]; } wn_vec;
layout(set = 0, binding = 1) readonly buffer WNMag { float data[]; } wn_mag;
layout(set = 0, binding = 2) writeonly buffer WNOut { float data[]; } wn_out;

void main_weight_norm_f32() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= args.data.rows) return;
    uint base = row * args.data.width;
    float square_sum = 0.0f;
    for (uint index = 0u; index < args.data.width; index++) {
        float value = wn_vec.data[base + index];
        square_sum = fma(value, value, square_sum);
    }
    float scale = wn_mag.data[row] * inversesqrt(square_sum);
    for (uint index = 0u; index < args.data.width; index++) {
        wn_out.data[base + index] = wn_vec.data[base + index] * scale;
    }
}

/* snake1d: x + sin(a*x)^2 / (a + 1e-9) */

layout(set = 0, binding = 0) readonly buffer SnIn { float data[]; } sn_in;
layout(set = 0, binding = 1) readonly buffer SnA { float data[]; } sn_a;
layout(set = 0, binding = 2) writeonly buffer SnOut { float data[]; } sn_out;

void main_snake1d_f32() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.elements) return;
    float a = sn_a.data[gid % args.data.conv_in_channels];
    float x = sn_in.data[gid];
    float wave = sin(a * x);
    sn_out.data[gid] = x + wave * wave / (a + 1e-9f);
}

/* Fused BigVGAN 2x upsample -> SnakeBeta -> 2x low-pass downsample at the
 * original rate; filters are the fixed 12-tap windowed-sinc kernels. */

layout(set = 0, binding = 0) readonly buffer AFIn { float data[]; } af_in;
layout(set = 0, binding = 1) readonly buffer AFAlpha { float data[]; } af_alpha;
layout(set = 0, binding = 2) readonly buffer AFBeta { float data[]; } af_beta;
layout(set = 0, binding = 3) readonly buffer AFUp { float data[]; } af_up;
layout(set = 0, binding = 4) readonly buffer AFDown { float data[]; } af_down;
layout(set = 0, binding = 5) writeonly buffer AFOut { float data[]; } af_out;

void main_alias_free_snake_f32() {
    uint channel = gl_GlobalInvocationID.x;
    uint time = gl_GlobalInvocationID.y;
    uint batch = gl_GlobalInvocationID.z;
    uint channels = args.data.conv_in_channels;
    uint length = args.data.conv_depth;
    if (channel >= channels || time >= length || batch >= args.data.conv_batch)
        return;
    float alpha = exp(af_alpha.data[channel]);
    float beta = exp(af_beta.data[channel]);
    float result = 0.0f;
    for (int down_k = 0; down_k < 12; down_k++) {
        int up_time = int(time * 2u) + down_k - 5;
        up_time = clamp(up_time, 0, int(length * 2u) - 1);
        int raw_time = up_time + 15;
        float upsampled = 0.0f;
        for (int up_k = 0; up_k < 12; up_k++) {
            int numerator = raw_time - up_k;
            if (numerator < 0 || (numerator & 1) != 0) continue;
            int padded_time = numerator / 2;
            int source_time = clamp(padded_time - 5, 0, int(length) - 1);
            uint source = (batch * length + uint(source_time)) * channels +
                          channel;
            upsampled = fma(af_in.data[source],
                            2.0f * af_up.data[uint(up_k)], upsampled);
        }
        float sine = sin(alpha * upsampled);
        float activated = upsampled + sine * sine / (beta + 1e-9f);
        result = fma(activated, af_down.data[uint(down_k)], result);
    }
    uint destination = (batch * length + time) * channels + channel;
    af_out.data[destination] = result;
}

/* audio QKV split with per-head biases */

layout(set = 0, binding = 0) readonly buffer AQSQKV { float data[]; } aqs_qkv;
layout(set = 0, binding = 1) readonly buffer AQSQ { float data[]; } aqs_qb;
layout(set = 0, binding = 2) readonly buffer AQSK { float data[]; } aqs_kb;
layout(set = 0, binding = 3) readonly buffer AQSV { float data[]; } aqs_vb;
layout(set = 0, binding = 4) writeonly buffer AQSQOut { float data[]; } aqs_q;
layout(set = 0, binding = 5) writeonly buffer AQSKOut { float data[]; } aqs_k;
layout(set = 0, binding = 6) writeonly buffer AQSVOut { float data[]; } aqs_v;

void main_audio_qkv_split_f32() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.elements) return;
    uint width = args.data.conv_width * args.data.conv_height;
    uint column = gid % width;
    uint row = gid / width;
    uint base = row * width * 3u;
    aqs_q.data[gid] = aqs_qkv.data[base + column] + aqs_qb.data[column];
    aqs_k.data[gid] = aqs_qkv.data[base + width + column] + aqs_kb.data[column];
    aqs_v.data[gid] = aqs_qkv.data[base + width * 2u + column] +
                      aqs_vb.data[column];
}

/* audio attention pooling over heads and head_dim groups */

layout(set = 0, binding = 0) readonly buffer APIn { float data[]; } ap_in;
layout(set = 0, binding = 1) writeonly buffer APOut { float data[]; } ap_out;

void main_audio_attention_pool_f32() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= args.data.elements) return;
    uint column = gid % args.data.conv_in_channels;
    uint row = gid / args.data.conv_in_channels;
    uint pool = args.data.conv_height / args.data.conv_in_channels;
    float sum = 0.0f;
    for (uint head = 0u; head < args.data.conv_width; head++) {
        uint base = (row * args.data.conv_width + head) *
                        args.data.conv_height +
                    column * pool;
        for (uint item = 0u; item < pool; item++)
            sum += ap_in.data[base + item];
    }
    ap_out.data[gid] = sum / float(args.data.conv_width * pool);
}

/* conv1d (OIK weights, stride/padding/dilation) and conv-transpose1d (IOK) */

layout(set = 0, binding = 0) readonly buffer C1In { float data[]; } c1_in;
layout(set = 0, binding = 1) readonly buffer C1W { float data[]; } c1_w;
layout(set = 0, binding = 2) readonly buffer C1B { float data[]; } c1_b;
layout(set = 0, binding = 3) writeonly buffer C1Out { float data[]; } c1_out;

void main_conv1d_stride_f32() {
    uint oc = gl_GlobalInvocationID.x;
    uint time = gl_GlobalInvocationID.y;
    uint batch = gl_GlobalInvocationID.z;
    uint length = args.data.conv_depth;
    uint in_channels = args.data.conv_in_channels;
    uint out_channels = args.data.conv_out_channels;
    uint kernel = args.data.conv_kernel_width;
    uint stride = args.data.conv_stride_width;
    uint padding = args.data.conv_stride_height;
    uint dilation = args.data.conv_stride_depth;
    uint effective = dilation * (kernel - 1u) + 1u;
    uint output_length = (length + 2u * padding - effective) / stride + 1u;
    if (oc >= out_channels || time >= output_length ||
        batch >= args.data.conv_batch)
        return;
    float sum = args.data.has_bias != 0u ? c1_b.data[oc] : 0.0f;
    for (uint ic = 0u; ic < in_channels; ic++) {
        for (uint k = 0u; k < kernel; k++) {
            int source = int(time * stride) + int(k * dilation) -
                         int(padding);
            if (source < 0 || source >= int(length)) continue;
            uint input_index =
                (batch * length + uint(source)) * in_channels + ic;
            uint weight_index = (oc * in_channels + ic) * kernel + k;
            sum = fma(c1_in.data[input_index], c1_w.data[weight_index], sum);
        }
    }
    uint output_index =
        (batch * output_length + time) * out_channels + oc;
    c1_out.data[output_index] = sum;
}

void main_conv_transpose1d_f32() {
    uint oc = gl_GlobalInvocationID.x;
    uint time = gl_GlobalInvocationID.y;
    uint batch = gl_GlobalInvocationID.z;
    uint length = args.data.conv_depth;
    uint in_channels = args.data.conv_in_channels;
    uint out_channels = args.data.conv_out_channels;
    uint kernel = args.data.conv_kernel_width;
    uint stride = args.data.conv_stride_width;
    uint padding = args.data.conv_stride_height;
    uint output_length = (length - 1u) * stride + kernel - 2u * padding;
    if (oc >= out_channels || time >= output_length ||
        batch >= args.data.conv_batch)
        return;
    float sum = args.data.has_bias != 0u ? c1_b.data[oc] : 0.0f;
    for (uint ic = 0u; ic < in_channels; ic++) {
        for (uint k = 0u; k < kernel; k++) {
            int numerator = int(time) + int(padding) - int(k);
            if (numerator < 0 || numerator % int(stride) != 0) continue;
            uint source = uint(numerator) / stride;
            if (source >= length) continue;
            uint input_index = (batch * length + source) * in_channels + ic;
            /* IOK weight layout: [in_ch][out_ch][kernel] */
            uint weight_index = (ic * out_channels + oc) * kernel + k;
            sum = fma(c1_in.data[input_index], c1_w.data[weight_index], sum);
        }
    }
    uint output_index =
        (batch * output_length + time) * out_channels + oc;
    c1_out.data[output_index] = sum;
}

/* causal SDPA (f32, batch dimension) */

layout(set = 0, binding = 0) readonly buffer SdpCQ { float data[]; } sdpc_q;
layout(set = 0, binding = 1) readonly buffer SdpCK { float data[]; } sdpc_k;
layout(set = 0, binding = 2) readonly buffer SdpCV { float data[]; } sdpc_v;
layout(set = 0, binding = 3) writeonly buffer SdpCOut { float data[]; } sdpc_out;

void main_sdpa_causal_f32() {
    uint head = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    uint batch = gl_GlobalInvocationID.z;
    uint seq = args.data.rows;
    uint heads = args.data.width;
    uint dim = args.data.input_dim;
    uint batches = args.data.conv_batch;
    if (row >= seq || head >= heads || batch >= batches) return;
    float scale = args.data.left_scale;
    uint qbase = ((batch * seq + row) * heads + head) * dim;
    float maxv = -3.402823466e+38f;
    for (uint s = 0u; s <= row; s++) {
        uint kbase = ((batch * seq + s) * heads + head) * dim;
        float dot = 0.0f;
        for (uint d = 0u; d < dim; d++) {
            dot = fma(sdpc_q.data[qbase + d], sdpc_k.data[kbase + d], dot);
        }
        dot *= scale;
        maxv = max(maxv, dot);
    }
    float sum = 0.0f;
    for (uint s = 0u; s <= row; s++) {
        uint kbase = ((batch * seq + s) * heads + head) * dim;
        float dot = 0.0f;
        for (uint d = 0u; d < dim; d++) {
            dot = fma(sdpc_q.data[qbase + d], sdpc_k.data[kbase + d], dot);
        }
        sum += exp(dot * scale - maxv);
    }
    for (uint d = 0u; d < dim; d++) {
        float acc = 0.0f;
        for (uint s = 0u; s <= row; s++) {
            uint kbase = ((batch * seq + s) * heads + head) * dim;
            float dot = 0.0f;
            for (uint k = 0u; k < dim; k++) {
                dot = fma(sdpc_q.data[qbase + k],
                          sdpc_k.data[kbase + k], dot);
            }
            acc = fma(exp(dot * scale - maxv), sdpc_v.data[kbase + d], acc);
        }
        sdpc_out.data[qbase + d] = acc / sum;
    }
}

/* Causal online-softmax SDPA. One 256-thread workgroup owns a
 * (batch,head,row) tuple and computes each QK dot once. This replaces the
 * cubic-in-head-dimension reference kernel for long AudioVAE sequences. */
shared float sdpcf_query[256];
shared float sdpcf_dots[256];
shared float sdpcf_accumulator[256];
shared float sdpcf_maximum;
shared float sdpcf_old_maximum;
shared float sdpcf_sum;

void main_sdpa_causal_flash_f32() {
    uint d = gl_LocalInvocationID.x;
    uint head = gl_WorkGroupID.x;
    uint row = gl_WorkGroupID.y;
    uint batch = gl_WorkGroupID.z;
    uint seq = args.data.rows;
    uint heads = args.data.width;
    uint dim = args.data.input_dim;
    if (batch >= args.data.conv_batch || row >= seq || head >= heads) return;
    uint qbase = ((batch * seq + row) * heads + head) * dim;
    sdpcf_query[d] = d < dim ? sdpc_q.data[qbase + d] : 0.0f;
    sdpcf_accumulator[d] = 0.0f;
    if (d == 0u) {
        sdpcf_maximum = -3.402823466e+38f;
        sdpcf_sum = 0.0f;
    }
    barrier();
    for (uint source = 0u; source <= row; source++) {
        uint kbase = ((batch * seq + source) * heads + head) * dim;
        sdpcf_dots[d] = d < dim ?
            fma(sdpcf_query[d], sdpc_k.data[kbase + d], 0.0f) : 0.0f;
        barrier();
        for (uint stride = 128u; stride > 0u; stride >>= 1u) {
            if (d < stride)
                sdpcf_dots[d] += sdpcf_dots[d + stride];
            barrier();
        }
        float score = sdpcf_dots[0] * args.data.left_scale;
        if (d == 0u) {
            float new_maximum = max(sdpcf_maximum, score);
            sdpcf_old_maximum = sdpcf_maximum;
            sdpcf_maximum = new_maximum;
            sdpcf_sum = sdpcf_sum *
                exp(sdpcf_old_maximum - new_maximum) +
                exp(score - new_maximum);
        }
        barrier();
        float previous_scale = exp(sdpcf_old_maximum - sdpcf_maximum);
        float probability = exp(score - sdpcf_maximum);
        float value = d < dim ? sdpc_v.data[kbase + d] : 0.0f;
        sdpcf_accumulator[d] =
            sdpcf_accumulator[d] * previous_scale + probability * value;
        barrier();
    }
    if (d < dim)
        sdpc_out.data[qbase + d] = sdpcf_accumulator[d] / sdpcf_sum;
}

/* ------------------------------------------------------ vision QKV + RoPE */

layout(set = 0, binding = 0) readonly buffer VisIn { uint16_t data[]; } vis_in;
layout(set = 0, binding = 1) readonly buffer VisCos { uint16_t data[]; } vis_cos;
layout(set = 0, binding = 2) readonly buffer VisSin { uint16_t data[]; } vis_sin;
layout(set = 0, binding = 3) writeonly buffer VisQ { uint16_t data[]; } vis_q;
layout(set = 0, binding = 4) writeonly buffer VisK { uint16_t data[]; } vis_k;
layout(set = 0, binding = 5) writeonly buffer VisV { uint16_t data[]; } vis_v;

void main_vision_qkv_rope_bf16() {
    uint dimension = gl_GlobalInvocationID.x;
    uint head = gl_GlobalInvocationID.y;
    uint row = gl_GlobalInvocationID.z;
    uint head_dim = args.data.input_dim;
    uint heads = args.data.width;
    uint sequence = args.data.rows;
    uint half_dim = args.data.output_dim;
    if (dimension >= head_dim || head >= heads || row >= sequence) return;
    uint inner = heads * head_dim;
    uint row_base = row * inner * 3u;
    uint q_base = row_base + head * head_dim;
    uint k_base = row_base + inner + head * head_dim;
    uint v_base = row_base + inner * 2u + head * head_dim;
    uint rope_index = row * half_dim + dimension % half_dim;
    float c = H3_BF16_TO_F32(vis_cos.data[rope_index]);
    float s = H3_BF16_TO_F32(vis_sin.data[rope_index]);
    uint pair = dimension < half_dim ? dimension + half_dim :
                                        dimension - half_dim;
    float q0 = H3_BF16_TO_F32(vis_in.data[q_base + dimension]);
    float k0 = H3_BF16_TO_F32(vis_in.data[k_base + dimension]);
    float q1 = H3_BF16_TO_F32(vis_in.data[q_base + pair]);
    float k1 = H3_BF16_TO_F32(vis_in.data[k_base + pair]);
    float qr = dimension < half_dim ? q0 * c - q1 * s : q0 * c + q1 * s;
    float kr = dimension < half_dim ? k0 * c - k1 * s : k0 * c + k1 * s;
    uint output_index = (row * heads + head) * head_dim + dimension;
    vis_q.data[output_index] = uint16_t(h3_f32_to_bf16(qr));
    vis_k.data[output_index] = uint16_t(h3_f32_to_bf16(kr));
    vis_v.data[output_index] = vis_in.data[v_base + dimension];
}

/* ------------------------------------------------------------ int8 mode */

/* Per-row BF16 -> int8 quantization, matching the Metal scalar kernel:
 * scale = max(|row|) * clip / 127, q = clamp(rint(x / scale), -127, 127).
 * Out-of-range rows are zeroed with scale 1.0. */

layout(set = 0, binding = 0) readonly buffer QIn { uint16_t data[]; } q_in;
layout(set = 0, binding = 1) writeonly buffer QOut { int8_t data[]; } q_out;
layout(set = 0, binding = 2) writeonly buffer QScales { float data[]; } q_scales;

shared float q_reductions[256];

void main_quantize_rows_bf16_i8() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint base = row * args.data.width;
    if (row >= args.data.rows) {
        for (uint column = tid; column < args.data.width; column += 256u) {
            q_out.data[base + column] = int8_t(0);
        }
        if (tid == 0u) q_scales.data[row] = 1.0f;
        return;
    }
    float local_max = 0.0f;
    for (uint column = tid; column < args.data.width; column += 256u) {
        local_max = max(local_max, abs(H3_BF16_TO_F32(q_in.data[base + column])));
    }
    q_reductions[tid] = local_max;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) q_reductions[tid] = max(q_reductions[tid],
                                                  q_reductions[tid + stride]);
        barrier();
    }
    float max_abs = q_reductions[0];
    float clipped_max = max_abs * args.data.left_scale;
    float scale = clipped_max > 0.0f ? clipped_max / 127.0f : 1.0f / 127.0f;
    float inverse = clipped_max > 0.0f ? 127.0f / clipped_max : 127.0f;
    if (tid == 0u) q_scales.data[row] = scale;
    for (uint column = tid; column < args.data.width; column += 256u) {
        int quantized = int(roundEven(H3_BF16_TO_F32(q_in.data[base + column]) *
                                 inverse));
        q_out.data[base + column] = int8_t(clamp(quantized, -127, 127));
    }
}

/* Gather SDPA's [head,row,dimension] output while quantizing directly to the
 * [row,head*dimension] layout consumed by the projection. */
void main_quantize_head_major_rows_bf16_i8() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint heads = args.data.width;
    uint head_dim = args.data.input_dim;
    uint columns = heads * head_dim;
    uint output_base = row * columns;
    float local_max = 0.0f;
    for (uint column = tid; column < columns; column += 256u) {
        uint head = column / head_dim;
        uint dimension = column - head * head_dim;
        uint source = (head * args.data.rows + row) * head_dim + dimension;
        local_max = max(local_max,
                        abs(H3_BF16_TO_F32(q_in.data[source])));
    }
    q_reductions[tid] = local_max;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) q_reductions[tid] = max(q_reductions[tid],
                                                  q_reductions[tid + stride]);
        barrier();
    }
    float max_abs = q_reductions[0];
    float clipped_max = max_abs * args.data.left_scale;
    float scale = clipped_max > 0.0f ? clipped_max / 127.0f : 1.0f / 127.0f;
    float inverse = clipped_max > 0.0f ? 127.0f / clipped_max : 127.0f;
    if (tid == 0u) q_scales.data[row] = scale;
    for (uint column = tid; column < columns; column += 256u) {
        uint head = column / head_dim;
        uint dimension = column - head * head_dim;
        uint source = (head * args.data.rows + row) * head_dim + dimension;
        int quantized = int(roundEven(H3_BF16_TO_F32(q_in.data[source]) *
                                      inverse));
        q_out.data[output_base + column] =
            int8_t(clamp(quantized, -127, 127));
    }
}

/* int8 matmul: acc = sum(q_in * w) in int32, out = bf16(acc * in_s * w_s). */


void main_linear_int8_bf16() {
    uint local_column = gl_LocalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint column_base = gl_WorkGroupID.x * 32u + local_column;
    uint row = gl_WorkGroupID.y * 32u + local_row;
    int acc[4];
    for (uint part = 0u; part < 4u; part++) acc[part] = 0;
    uint tile_count = (args.data.input_dim + 31u) / 32u;
    for (uint tile = 0u; tile < tile_count; tile++) {
        for (uint part = 0u; part < 4u; part++) {
            uint tile_k = local_column + part * 8u;
            uint input_k = tile * 32u + tile_k;
            lin8_in_tile[local_row][tile_k] =
                row < args.data.rows && input_k < args.data.input_dim ?
                l8_in.data[row * args.data.input_dim + input_k] : int8_t(0);
        }
        uint weight_k = tile * 32u + local_row;
        for (uint part = 0u; part < 4u; part++) {
            uint column = column_base + part * 8u;
            lin8_w_tile[local_row][local_column + part * 8u] =
                column < args.data.output_dim &&
                weight_k < args.data.input_dim ?
                l8_w.data[column * args.data.input_dim + weight_k] :
                int8_t(0);
        }
        barrier();
        for (uint k = 0u; k < 32u; k++) {
            int input_value = int(lin8_in_tile[local_row][k]);
            for (uint part = 0u; part < 4u; part++)
                acc[part] += input_value *
                    int(lin8_w_tile[k][local_column + part * 8u]);
        }
        barrier();
    }
    if (row < args.data.rows) {
        float input_scale = l8_is.data[row];
        for (uint part = 0u; part < 4u; part++) {
            uint column = column_base + part * 8u;
            if (column < args.data.output_dim) {
                float dequant = float(acc[part]) * input_scale *
                                l8_ws.data[column];
                l8_out.data[row * args.data.output_dim + column] =
                    uint16_t(h3_f32_to_bf16(dequant));
            }
        }
    }
}

/* Grouped quantizer (Metal h3_quantize_bf16_int8_groups_scalar128): one
 * workgroup per row, one max-abs scale per 1024-wide column group.  The
 * MLP FC2 path uses this so each group carries its own quantization. */
void main_quantize_rows_groups_bf16_i8() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint columns = args.data.width;
    uint groups = args.data.output_dim;
    uint group_size = args.data.elements;
    uint base = row * columns;
    if (row >= args.data.rows) {
        for (uint column = tid; column < columns; column += 256u)
            q_out.data[base + column] = int8_t(0);
        for (uint group = tid; group < groups; group += 256u)
            q_scales.data[row * groups + group] = 1.0f;
        return;
    }
    for (uint group = 0u; group < groups; group++) {
        uint start = group * group_size;
        float local_max = 0.0f;
        for (uint local = tid; local < group_size; local += 256u)
            local_max = max(local_max,
                            abs(H3_BF16_TO_F32(q_in.data[base + start + local])));
        q_reductions[tid] = local_max;
        barrier();
        for (uint stride = 128u; stride > 0u; stride >>= 1) {
            if (tid < stride) q_reductions[tid] = max(q_reductions[tid],
                                                      q_reductions[tid + stride]);
            barrier();
        }
        float max_abs = q_reductions[0];
        float scale = max_abs > 0.0f ? max_abs / 127.0f : 1.0f / 127.0f;
        float inverse = max_abs > 0.0f ? 127.0f / max_abs : 127.0f;
        if (tid == 0u) {
            q_scales.data[row * groups + group] = scale;
        }
        for (uint local = tid; local < group_size; local += 256u) {
            int quantized = int(roundEven(H3_BF16_TO_F32(q_in.data[base + start + local]) *
                                     inverse));
            q_out.data[base + start + local] = int8_t(clamp(quantized, -127, 127));
        }
        barrier();
    }
}

/* Fused fc1 (gate|up halves) -> SwiGLU in int8 with per-column weight
 * scales; one BF16 rounding after the dequantized product.  Tiled like the
 * linear kernel; the exact integer sums keep the bit-exact semantics. */
shared int8_t fc1_in_tile[32][32];
shared int8_t fc1_g_tile[32][32];
shared int8_t fc1_u_tile[32][32];

void main_fc1_swiglu_int8_bf16() {
    uint local_column = gl_LocalInvocationID.x;
    uint local_row = gl_LocalInvocationID.y;
    uint column_base = gl_WorkGroupID.x * 32u + local_column;
    uint row = gl_WorkGroupID.y * 32u + local_row;
    uint hidden = args.data.output_dim;
    int acc_gate[4];
    int acc_up[4];
    for (uint part = 0u; part < 4u; part++) {
        acc_gate[part] = 0;
        acc_up[part] = 0;
    }
    uint tile_count = (args.data.input_dim + 31u) / 32u;
    for (uint tile = 0u; tile < tile_count; tile++) {
        for (uint part = 0u; part < 4u; part++) {
            uint tile_k = local_column + part * 8u;
            uint input_k = tile * 32u + tile_k;
            fc1_in_tile[local_row][tile_k] =
                row < args.data.rows && input_k < args.data.input_dim ?
                l8_in.data[row * args.data.input_dim + input_k] : int8_t(0);
        }
        uint weight_k = tile * 32u + local_row;
        for (uint part = 0u; part < 4u; part++) {
            uint column = column_base + part * 8u;
            uint shared_column = local_column + part * 8u;
            fc1_g_tile[local_row][shared_column] =
                column < hidden && weight_k < args.data.input_dim ?
                l8_w.data[column * args.data.input_dim + weight_k] :
                int8_t(0);
            fc1_u_tile[local_row][shared_column] =
                column < hidden && weight_k < args.data.input_dim ?
                l8_w.data[(hidden + column) * args.data.input_dim + weight_k] :
                int8_t(0);
        }
        barrier();
        for (uint k = 0u; k < 32u; k++) {
            int value = int(fc1_in_tile[local_row][k]);
            for (uint part = 0u; part < 4u; part++) {
                uint shared_column = local_column + part * 8u;
                acc_gate[part] += value *
                    int(fc1_g_tile[k][shared_column]);
                acc_up[part] += value *
                    int(fc1_u_tile[k][shared_column]);
            }
        }
        barrier();
    }
    if (row < args.data.rows) {
        float input_scale = l8_is.data[row];
        for (uint part = 0u; part < 4u; part++) {
            uint column = column_base + part * 8u;
            if (column >= hidden) continue;
            /* Match Metal: materialize gate in BF16 before SiLU. */
            float gate = H3_BF16_TO_F32(h3_f32_to_bf16(
                float(acc_gate[part]) * input_scale * l8_ws.data[column]));
            float up = float(acc_up[part]) * input_scale *
                       l8_ws.data[hidden + column];
            l8_out.data[row * hidden + column] = uint16_t(h3_f32_to_bf16(
                gate / (1.0f + exp(-gate)) * up));
        }
    }
}

/* Fused gate + AdaLN + per-row quantization (scalar semantics): gated
 * residual, RMS norm with modulated weight, shift/scale, then quantize. */

layout(set = 0, binding = 0) readonly buffer IARes { uint16_t data[]; } ia_res;
layout(set = 0, binding = 1) readonly buffer IABranch { uint16_t data[]; } ia_branch;
layout(set = 0, binding = 2) readonly buffer IAGMod { uint16_t data[]; } ia_gmod;
layout(set = 0, binding = 3) readonly buffer IAMap { uint data[]; } ia_map;
layout(set = 0, binding = 4) readonly buffer IAW { uint16_t data[]; } ia_w;
layout(set = 0, binding = 5) readonly buffer IANMod { uint16_t data[]; } ia_nmod;
layout(set = 0, binding = 6) writeonly buffer IAGated { uint16_t data[]; } ia_gated;
layout(set = 0, binding = 7) writeonly buffer IAOut { int8_t data[]; } ia_out;
layout(set = 0, binding = 8) writeonly buffer IAScales { float data[]; } ia_scales;

shared float ia_reductions[256];
shared uint16_t ia_values[5376];

void main_gate_adaln_quantize_int8() {
    uint row = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint width = args.data.width;
    if (row >= args.data.rows) {
        uint qbase = row * width;
        for (uint column = tid; column < width; column += 256u)
            ia_out.data[qbase + column] = int8_t(0);
        if (tid == 0u) ia_scales.data[row] = 1.0f;
        return;
    }
    uint base = ia_map.data[row] * args.data.slots * width;
    uint row_base = row * width;
    float local_sum = 0.0f;
    for (uint column = tid; column < width; column += 256u) {
        uint index = row_base + column;
        float gate = H3_BF16_TO_F32(
            ia_gmod.data[base + args.data.gate_slot * width + column]);
        uint16_t gated = uint16_t(h3_f32_to_bf16(
            fma(H3_BF16_TO_F32(ia_branch.data[index]), gate,
                H3_BF16_TO_F32(ia_res.data[index]))));
        ia_gated.data[index] = gated;
        ia_values[column] = gated;
        float value = H3_BF16_TO_F32(gated);
        local_sum = fma(value, value, local_sum);
    }
    ia_reductions[tid] = local_sum;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) ia_reductions[tid] += ia_reductions[tid + stride];
        barrier();
    }
    float inverse = inversesqrt(ia_reductions[0] / float(width) +
                                args.data.epsilon);
    float local_max = 0.0f;
    for (uint column = tid; column < width; column += 256u) {
        float normalized = H3_BF16_TO_F32(ia_values[column]) * inverse *
            H3_BF16_TO_F32(ia_w.data[column]);
        float shift = H3_BF16_TO_F32(
            ia_nmod.data[base + args.data.shift_slot * width + column]);
        float scale = H3_BF16_TO_F32(
            ia_nmod.data[base + args.data.scale_slot * width + column]);
        uint16_t value = uint16_t(h3_f32_to_bf16(
            fma(normalized, 1.0f + scale, shift)));
        ia_values[column] = value;
        local_max = max(local_max, abs(H3_BF16_TO_F32(value)));
    }
    ia_reductions[tid] = local_max;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (tid < stride) ia_reductions[tid] = max(ia_reductions[tid],
                                                   ia_reductions[tid + stride]);
        barrier();
    }
    float max_abs = ia_reductions[0];
    float output_scale = max_abs > 0.0f ? max_abs / 127.0f : 1.0f / 127.0f;
    float quantize_scale = max_abs > 0.0f ? 127.0f / max_abs : 127.0f;
    if (tid == 0u) ia_scales.data[row] = output_scale;
    for (uint column = tid; column < width; column += 256u) {
        int value = int(roundEven(H3_BF16_TO_F32(ia_values[column]) *
                             quantize_scale));
        ia_out.data[row_base + column] = int8_t(clamp(value, -127, 127));
    }
}

/* The runtime compiles one module per kernel with H3_ENTRY selecting the
 * kernel function; glslc testing uses -DH3_ENTRY=main_<kernel>. */
void main() { H3_ENTRY(); }
